@model ITHelpdeshMangament.Models.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var inv = System.Globalization.CultureInfo.InvariantCulture;

    double Percent(double part, double total) => total <= 0 ? 0 : Math.Round(part / total * 100, 1);
    string Width(double value) => Math.Clamp(value, 0, 100).ToString("0.#", inv);
    string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim().Substring(0, 1).ToUpperInvariant();
    string RateClass(double rate) => rate >= 90 ? "rate-good" : rate >= 70 ? "rate-warn" : "rate-bad";

    var responsePct = Percent(Model.ResponseOverdueCount, Model.TotalTicketsWithSla);
    var resolutionPct = Percent(Model.ResolutionOverdueCount, Model.TotalTicketsWithSla);
    var resolvedPct = Percent(Model.ResolvedTickets, Model.TotalTickets);
}

<style>
    .dash-page {
        --radius: 16px;
    }

    /* ---------- Header ---------- */
    .dash-header {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        padding: 28px 32px;
        color: #fff;
        background: linear-gradient(135deg, #312e81 0%, #4f46e5 55%, #7c3aed 100%);
        box-shadow: 0 18px 35px -18px rgba(79, 70, 229, 0.7);
    }

        .dash-header::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            right: -80px;
            top: -120px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
        }

        .dash-header h2 {
            font-weight: 700;
            margin-bottom: 4px;
        }

        .dash-header p {
            opacity: 0.85;
            margin: 0;
        }

    .role-pill {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(6px);
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.05rem;
        font-weight: 700;
        color: #111827;
        margin: 36px 0 16px;
    }

        .section-title::before {
            content: "";
            width: 4px;
            height: 20px;
            border-radius: 4px;
            background: linear-gradient(180deg, #4f46e5, #7c3aed);
        }

    /* ---------- KPI cards ---------- */
    .stat-card {
        border: 1px solid #eef0f4;
        border-radius: var(--radius);
        background: #fff;
        box-shadow: 0 6px 18px -10px rgba(17, 24, 39, 0.15);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 28px -14px rgba(17, 24, 39, 0.25);
        }

    .stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }

        .stat-icon.indigo {
            background: #eef2ff;
            color: #4f46e5;
        }

        .stat-icon.blue {
            background: #e0f2fe;
            color: #0284c7;
        }

        .stat-icon.amber {
            background: #fef3c7;
            color: #d97706;
        }

        .stat-icon.green {
            background: #dcfce7;
            color: #16a34a;
        }

        .stat-icon.slate {
            background: #f1f5f9;
            color: #475569;
        }

        .stat-icon.red {
            background: #fee2e2;
            color: #dc2626;
        }

    .stat-label {
        font-size: 0.85rem;
        font-weight: 500;
        color: #6b7280;
        margin-bottom: 2px;
    }

    .stat-value {
        font-size: 1.9rem;
        font-weight: 700;
        line-height: 1.2;
        color: #111827;
        margin: 0;
    }

    .stat-progress {
        height: 6px;
        border-radius: 999px;
        background: #f3f4f6;
        overflow: hidden;
    }

        .stat-progress > span {
            display: block;
            height: 100%;
            border-radius: 999px;
        }

        .stat-progress .bar-green {
            background: linear-gradient(90deg, #22c55e, #16a34a);
        }

        .stat-progress .bar-red {
            background: linear-gradient(90deg, #f87171, #dc2626);
        }

        .stat-progress .bar-indigo {
            background: linear-gradient(90deg, #6366f1, #7c3aed);
        }

    .stat-hint {
        font-size: 0.78rem;
        color: #9ca3af;
        margin-top: 6px;
    }

    /* ---------- Chart cards ---------- */
    .chart-card {
        border: 1px solid #eef0f4;
        border-radius: var(--radius);
        background: #fff;
        box-shadow: 0 6px 18px -10px rgba(17, 24, 39, 0.15);
    }

        .chart-card .chart-head {
            padding: 18px 22px 0;
        }

            .chart-card .chart-head h6 {
                font-weight: 700;
                color: #111827;
                margin: 0;
            }

            .chart-card .chart-head small {
                color: #9ca3af;
            }

        .chart-card .chart-body {
            padding: 16px 22px 22px;
        }

    /* ---------- Analytics cards ---------- */
    .analytics-card {
        --accent: #6366f1;
        position: relative;
        height: 100%;
        border: 1px solid #eef0f4;
        border-radius: var(--radius);
        background: #fff;
        box-shadow: 0 6px 18px -10px rgba(17, 24, 39, 0.15);
        padding: 20px 22px;
        overflow: hidden;
    }

        .analytics-card.accent::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--accent);
        }

        .analytics-card h6 {
            font-weight: 700;
            color: #111827;
            margin-bottom: 4px;
        }

        .analytics-card .subtitle {
            font-size: 0.8rem;
            color: #9ca3af;
        }

    .accent-green {
        --accent: #22c55e;
    }

    .accent-indigo {
        --accent: #6366f1;
    }

    .accent-sky {
        --accent: #0ea5e9;
    }

    .accent-amber {
        --accent: #f59e0b;
    }

    .accent-red {
        --accent: #ef4444;
    }

    .accent-slate {
        --accent: #94a3b8;
    }

    .analytics-metric {
        font-size: 1.75rem;
        font-weight: 700;
        line-height: 1.25;
        color: #111827;
    }

    .analytics-label {
        font-size: 0.82rem;
        color: #6b7280;
    }

    .tone-green {
        color: #16a34a;
    }

    .tone-indigo {
        color: #4f46e5;
    }

    .tone-sky {
        color: #0284c7;
    }

    .tone-amber {
        color: #d97706;
    }

    .tone-red {
        color: #dc2626;
    }

    .priority-tile {
        border-radius: 12px;
        padding: 12px 14px;
        height: 100%;
    }

        .priority-tile .analytics-metric {
            font-size: 1.45rem;
        }

        .priority-tile.low {
            background: #f0fdf4;
        }

        .priority-tile.medium {
            background: #f0f9ff;
        }

        .priority-tile.high {
            background: #fffbeb;
        }

        .priority-tile.critical {
            background: #fef2f2;
        }

    .mini-stat {
        border-radius: 12px;
        background: #f9fafb;
        padding: 10px 14px;
    }

    /* ---------- Tables ---------- */
    .analytics-scroll {
        overflow-x: auto;
    }

    .analytics-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.86rem;
    }

        .analytics-table th {
            color: #6b7280;
            font-weight: 600;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            background: #f9fafb;
            white-space: nowrap;
        }

            .analytics-table th:first-child {
                border-top-left-radius: 10px;
            }

            .analytics-table th:last-child {
                border-top-right-radius: 10px;
            }

        .analytics-table th,
        .analytics-table td {
            padding: 13px 14px;
            border-bottom: 1px solid #eef0f4;
            text-align: left;
            vertical-align: middle;
        }

        .analytics-table tbody tr {
            transition: background 0.12s ease;
        }

            .analytics-table tbody tr:hover {
                background: #f8f9ff;
            }

            .analytics-table tbody tr:last-child td {
                border-bottom: none;
            }

        .analytics-table .text-number {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

    .analytics-empty {
        color: #9ca3af;
        text-align: center;
        padding: 28px 12px !important;
        font-size: 0.88rem;
    }

    .person-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        font-size: 0.85rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
    }

    .rate-pill {
        display: inline-block;
        min-width: 64px;
        text-align: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .rate-pill.rate-good {
            background: #dcfce7;
            color: #15803d;
        }

        .rate-pill.rate-warn {
            background: #fef3c7;
            color: #b45309;
        }

        .rate-pill.rate-bad {
            background: #fee2e2;
            color: #b91c1c;
        }

    /* ---------- Filter bar ---------- */
    .filter-bar {
        margin-top: 20px;
        padding: 16px 20px;
        border: 1px solid #eef0f4;
        border-radius: var(--radius);
        background: #fff;
        box-shadow: 0 6px 18px -10px rgba(17, 24, 39, 0.15);
    }

    .filter-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        background: #eef2ff;
        color: #4f46e5;
    }

    .filter-title {
        font-weight: 700;
        color: #111827;
        line-height: 1.2;
    }

    .filter-period {
        font-size: 0.8rem;
        color: #9ca3af;
    }

    .range-toggle {
        position: relative;
        display: inline-flex;
        gap: 4px;
        padding: 4px;
        border-radius: 12px;
        background: #f3f4f6;
    }

        .range-toggle input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .range-toggle label {
            margin: 0;
            padding: 8px 16px;
            border-radius: 9px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #6b7280;
            cursor: pointer;
            white-space: nowrap;
            transition: background 0.15s, color 0.15s, box-shadow 0.15s;
        }

            .range-toggle label:hover {
                color: #4f46e5;
            }

        .range-toggle input:checked + label {
            background: #fff;
            color: #4f46e5;
            box-shadow: 0 2px 6px rgba(17, 24, 39, 0.12);
        }

        .range-toggle input:focus-visible + label {
            outline: 2px solid #4f46e5;
            outline-offset: 1px;
        }

    .date-fields {
        display: none;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: wrap;
    }

        .date-fields.show {
            display: flex;
            animation: fadeIn 0.2s ease both;
        }

        .date-fields .field-label {
            display: block;
            margin-bottom: 4px;
            font-size: 0.75rem;
            font-weight: 600;
            color: #6b7280;
        }

        .date-fields .form-control {
            height: 42px;
            min-width: 150px;
            border: 1.5px solid #e5e7eb;
            border-radius: 10px;
            font-size: 0.88rem;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

            .date-fields .form-control:focus {
                border-color: #4f46e5;
                box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.15);
            }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .btn-apply {
        height: 42px;
        padding: 0 22px;
        border: 0;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.88rem;
        color: #fff;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        box-shadow: 0 10px 20px -10px rgba(79, 70, 229, 0.7);
        transition: transform 0.15s, box-shadow 0.15s;
    }

        .btn-apply:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 14px 24px -10px rgba(79, 70, 229, 0.8);
        }

    /* ---------- Export reports ---------- */
    .export-card {
        margin-top: 16px;
        padding: 20px 22px;
        border: 1px solid #eef0f4;
        border-radius: var(--radius);
        background: #fff;
        box-shadow: 0 6px 18px -10px rgba(17, 24, 39, 0.15);
    }

        .export-card h6 {
            font-weight: 700;
            color: #111827;
            margin: 0;
        }

        .export-card .subtitle {
            font-size: 0.8rem;
            color: #9ca3af;
        }

    .export-tile {
        display: flex;
        align-items: center;
        gap: 14px;
        height: 100%;
        padding: 14px 16px;
        border: 1.5px solid #eef0f4;
        border-radius: 14px;
        background: #fff;
        color: inherit;
        text-decoration: none;
        transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    }

        .export-tile:hover {
            color: inherit;
            border-color: #c7d2fe;
            transform: translateY(-2px);
            box-shadow: 0 14px 24px -14px rgba(79, 70, 229, 0.45);
        }

        .export-tile:focus-visible {
            outline: 2px solid #4f46e5;
            outline-offset: 2px;
        }

        .export-tile .tile-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
        }

        .export-tile .tile-name {
            font-size: 0.9rem;
            font-weight: 600;
            color: #111827;
            line-height: 1.25;
        }

        .export-tile .tile-desc {
            font-size: 0.76rem;
            color: #9ca3af;
        }

        .export-tile .tile-download {
            margin-left: auto;
            flex-shrink: 0;
            color: #9ca3af;
            transition: color 0.15s, transform 0.15s;
        }

        .export-tile:hover .tile-download {
            color: #4f46e5;
            transform: translateY(2px);
        }

    /* ---------- Error banner ---------- */
    .error-banner {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #b91c1c;
        border-radius: 14px;
        padding: 14px 18px;
        margin-top: 20px;
    }

    @@media (max-width: 575.98px) {
        .dash-header {
            padding: 22px 20px;
        }

        .stat-value {
            font-size: 1.6rem;
        }
    }
</style>

<div class="dash-page container-fluid py-4">

    <!-- Header -->
    <div class="dash-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div style="position: relative; z-index: 1;">
            <h2>IT Helpdesk Dashboard</h2>
            <p>Overview of ticket activities and service performance</p>
        </div>

        <span class="role-pill">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            Admin / IT Staff
        </span>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="error-banner" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <div>@ViewBag.ErrorMessage</div>
        </div>
    }

    <!-- ===================== Filter ===================== -->
    <form asp-controller="Dashboard" asp-action="Index" method="get" id="filterForm" class="filter-bar">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">

            <div class="d-flex align-items-center gap-3">
                <div class="filter-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                </div>
                <div>
                    <div class="filter-title">Date Range</div>
                    <div class="filter-period">
                        @Model.FromDate.ToString("MMM dd, yyyy") &ndash; @Model.ToDate.ToString("MMM dd, yyyy")
                    </div>
                </div>
            </div>

            <div class="range-toggle" role="radiogroup" aria-label="Date range">
                <input type="radio" name="range" id="rangeToday" value="Today" checked="@(Model.Range == "Today")" />
                <label for="rangeToday">Today</label>

                <input type="radio" name="range" id="range7" value="Last7Days" checked="@(Model.Range == "Last7Days")" />
                <label for="range7">Last 7 Days</label>

                <input type="radio" name="range" id="range30" value="Last30Days" checked="@(Model.Range == "Last30Days")" />
                <label for="range30">Last 30 Days</label>

                <input type="radio" name="range" id="rangeCustom" value="Custom" checked="@(Model.Range == "Custom")" />
                <label for="rangeCustom">Custom</label>
            </div>

            <div class="date-fields" id="dateFields">
                <div>
                    <label for="fromDate" class="field-label">From</label>
                    <input id="fromDate" name="fromDate" type="date" class="form-control"
                           value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                </div>
                <div>
                    <label for="toDate" class="field-label">To</label>
                    <input id="toDate" name="toDate" type="date" class="form-control"
                           value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                </div>
                <button type="submit" class="btn btn-apply">Apply</button>
            </div>

        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
    </form>

    <!-- ===================== Export Reports ===================== -->
    <div class="export-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h6>Export Dashboard Reports</h6>
                <div class="subtitle">
                    Excel reports for tickets created between
                    @Model.FromDate.ToString("MMM dd, yyyy", inv) and @Model.ToDate.ToString("MMM dd, yyyy", inv)
                </div>
            </div>
        </div>

        <div class="row g-3">

            <div class="col-12 col-md-6 col-xl-3">
                <a class="export-tile"
                   asp-controller="Dashboard"
                   asp-action="ExportSummary"
                   asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")">
                    <span class="tile-icon stat-icon indigo">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="8" y1="13" x2="16" y2="13" />
                            <line x1="8" y1="17" x2="14" y2="17" />
                        </svg>
                    </span>
                    <span>
                        <span class="tile-name d-block">Summary</span>
                        <span class="tile-desc">Ticket totals and status</span>
                    </span>
                    <svg class="tile-download" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="7 10 12 15 17 10" />
                        <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                </a>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <a class="export-tile"
                   asp-controller="Dashboard"
                   asp-action="ExportSlaPerformance"
                   asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")">
                    <span class="tile-icon stat-icon green">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            <polyline points="9 12 11 14 15 10" />
                        </svg>
                    </span>
                    <span>
                        <span class="tile-name d-block">SLA Performance</span>
                        <span class="tile-desc">Response and resolution</span>
                    </span>
                    <svg class="tile-download" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="7 10 12 15 17 10" />
                        <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                </a>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <a class="export-tile"
                   asp-controller="Dashboard"
                   asp-action="ExportStaffPerformance"
                   asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")">
                    <span class="tile-icon stat-icon amber">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
