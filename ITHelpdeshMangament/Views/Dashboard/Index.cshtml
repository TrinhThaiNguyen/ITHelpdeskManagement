                                <td>
                                    <div class="person-cell">
                                        <div class="avatar">@Initial(staff.FullName)</div>
                                        <div>
                                            <div class="fw-semibold">@staff.FullName</div>
                                            <div class="subtitle">@staff.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@staff.DepartmentName</td>
                                <td class="text-number">@staff.TotalAssignedTickets</td>
                                <td class="text-number">@staff.ResolvedTickets</td>
                                <td class="text-number">@staff.AverageResolutionTimeHours.ToString("0.0")</td>
                                <td class="text-number">@staff.AverageFirstResponseTimeHours.ToString("0.0")</td>
                                <td class="text-number">
                                    <span class="rate-pill @RateClass(staffRate)">@staffRate.ToString("0.0")%</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="analytics-empty">No staff performance data available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===================== Department Performance ===================== -->
    <div class="section-title">Department Performance</div>

    <div class="analytics-card">
        <div class="mb-3">
            <h6>Department Overview</h6>
            <div class="subtitle">Ticket distribution, resolution time and SLA compliance by department</div>
        </div>

        <div class="analytics-scroll">
            <table class="analytics-table">
                <thead>
                    <tr>
                        <th>Department</th>
                        <th class="text-number">Total Tickets</th>
                        <th class="text-number">Assigned</th>
                        <th class="text-number">Unassigned</th>
                        <th class="text-number">Resolved</th>
                        <th class="text-number">Avg. Resolution (h)</th>
                        <th class="text-number">Avg. First Response (h)</th>
                        <th class="text-number">SLA Compliance</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DepartmentPerformance.Any())
                    {
                        foreach (var department in Model.DepartmentPerformance)
                        {
                            var departmentRate = Convert.ToDouble(department.ResolutionSlaComplianceRate);

                            <tr>
                                <td class="fw-semibold">@department.DepartmentName</td>
                                <td class="text-number">@department.TotalTickets</td>
                                <td class="text-number">@department.AssignedTickets</td>
                                <td class="text-number">@department.UnassignedTickets</td>
                                <td class="text-number">@department.ResolvedTickets</td>
                                <td class="text-number">@department.AverageResolutionTimeHours.ToString("0.0")</td>
                                <td class="text-number">@department.AverageFirstResponseTimeHours.ToString("0.0")</td>
                                <td class="text-number">
                                    <span class="rate-pill @RateClass(departmentRate)">@departmentRate.ToString("0.0")%</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="analytics-empty">No department performance data available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // ---------- Date range filter ----------
        (function () {
            const form = document.getElementById('filterForm');
            const dateFields = document.getElementById('dateFields');
            const fromDate = document.getElementById('fromDate');
            const toDate = document.getElementById('toDate');
            const radios = form.querySelectorAll('input[name="range"]');

            function selectedRange() {
                const checked = form.querySelector('input[name="range"]:checked');
                return checked ? checked.value : 'Today';
            }

            function sync() {
                const isCustom = selectedRange() === 'Custom';
                dateFields.classList.toggle('show', isCustom);
                fromDate.disabled = !isCustom;
                toDate.disabled = !isCustom;
            }

            radios.forEach(function (radio) {
                radio.addEventListener('change', function () {
                    sync();
                    // Quick ranges apply immediately; Custom waits for the Apply button
                    if (selectedRange() !== 'Custom') {
                        form.submit();
                    }
                });
            });

            sync();
        })();
    </script>

    <script>
        // ---------- Data from the server ----------
        const priorityRaw = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                            Model.PriorityStatistics.Select(x => x.Priority)
                    )
            );

    const priorityValues = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.PriorityStatistics.Select(x => x.Count)
                )
        );

    const statusRaw = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.StatusDistribution.Select(x => x.Status)
                )
        );

    const statusValues = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.StatusDistribution.Select(x => x.TicketCount)
                )
        );

    const trendLabels = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.TicketTrends.Select(x => x.Date.ToString("yyyy-MM-dd"))
                )
        );

    const trendValues = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.TicketTrends.Select(x => x.TotalTickets)
                )
        );

    const departmentLabels = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.DepartmentStatistics.Select(x => x.DepartmentName)
                )
        );

    const departmentValues = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.DepartmentStatistics.Select(x => x.TotalTickets)
                )
        );

    const reopenTrendLabels = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.ReopenRequestTrends.Select(x => x.Date.ToString("yyyy-MM-dd"))
                )
        );

    const reopenPendingValues = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.ReopenRequestTrends.Select(x => x.PendingCount)
                )
        );

    const reopenApprovedValues = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.ReopenRequestTrends.Select(x => x.ApprovedCount)
                )
        );

    const reopenRejectedValues = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.ReopenRequestTrends.Select(x => x.RejectedCount)
                )
        );

    const slaPriorityData = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.SlaPriorityStatistics.Select(x => new
                        {
                                priority = x.Priority,
                                totalBreached = x.TotalBreachedCount,
                                responseBreached = x.ResponseBreachedCount,
                                resolutionBreached = x.ResolutionBreachedCount
                        })
                )
        );

    const slaTrendLabels = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.SlaBreachTrends.Select(x => x.Date.ToString("yyyy-MM-dd"))
                )
        );

    const slaResponseTrend = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.SlaBreachTrends.Select(x => x.ResponseBreachedCount)
                )
        );

    const slaResolutionTrend = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.SlaBreachTrends.Select(x => x.ResolutionBreachedCount)
                )
        );

    // ---------- Enum -> label (works for numbers and for strings) ----------
    const priorityNames = { 1: 'Low', 2: 'Medium', 3: 'High', 4: 'Critical' };
    const statusNames = { 1: 'New', 2: 'Open', 3: 'In Progress', 4: 'Pending', 5: 'Resolved', 6: 'Closed' };

        function priorityName(value) {
            return typeof value === 'number' ? (priorityNames[value] ?? 'Unknown') : String(value);
        }

        function statusName(value) {
            return typeof value === 'number' ? (statusNames[value] ?? 'Unknown') : String(value);
        }

        const priorityLabels = priorityRaw.map(priorityName);
        const statusLabels = statusRaw.map(statusName);

        // ---------- Theme (matches the Login / Dashboard palette) ----------
        const palette = {
            indigo: '#4f46e5',
            violet: '#7c3aed',
            sky: '#0ea5e9',
            green: '#22c55e',
            amber: '#f59e0b',
            red: '#ef4444',
            pink: '#ec4899',
            slate: '#94a3b8'
        };

        const fallbackColors = [
            palette.indigo, palette.violet, palette.sky,
            palette.green, palette.amber, palette.red,
            palette.pink, palette.slate
        ];

        // Known label -> color; unknown labels fall back to the palette by index
        const semanticColors = {
            low: palette.green,
            medium: palette.sky,
            normal: palette.sky,
            high: palette.amber,
            urgent: palette.red,
            critical: palette.red,
            new: palette.sky,
            open: palette.indigo,
            assigned: palette.violet,
            inprogress: palette.amber,
            onhold: palette.slate,
            pending: palette.slate,
            resolved: palette.green,
            closed: palette.violet,
            cancelled: palette.red,
            rejected: palette.red
        };

        function colorsFor(labels) {
            return labels.map(function (label, i) {
                const key = String(label).toLowerCase().replace(/[\s_-]/g, '');
                return semanticColors[key] || fallbackColors[i % fallbackColors.length];
            });
        }

        Chart.defaults.font.family = "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif";
        Chart.defaults.font.size = 12;
        Chart.defaults.color = '#6b7280';
        Chart.defaults.plugins.legend.labels.usePointStyle = true;
        Chart.defaults.plugins.legend.labels.pointStyle = 'circle';
        Chart.defaults.plugins.legend.labels.boxWidth = 8;
        Chart.defaults.plugins.legend.labels.padding = 16;
        Chart.defaults.plugins.tooltip.backgroundColor = '#111827';
        Chart.defaults.plugins.tooltip.padding = 12;
        Chart.defaults.plugins.tooltip.cornerRadius = 10;
        Chart.defaults.plugins.tooltip.titleFont = { weight: '600' };
        Chart.defaults.plugins.tooltip.boxPadding = 4;

        const gridColor = 'rgba(17, 24, 39, 0.06)';

        function verticalScales() {
            return {
                x: { grid: { display: false }, border: { display: false } },
                y: {
                    beginAtZero: true,
                    border: { display: false },
                    grid: { color: gridColor },
                    ticks: { precision: 0 }
                }
            };
        }

        function lineDataset(label, data, color, fillColor) {
            return {
                label: label,
                data: data,
                borderColor: color,
                backgroundColor: fillColor,
                borderWidth: 2.5,
                tension: 0.4,
                fill: true,
                pointRadius: 2,
                pointHoverRadius: 6,
                pointBackgroundColor: '#ffffff',
                pointBorderColor: color,
                pointBorderWidth: 2
            };
        }

        // ---------- Priority (doughnut) ----------
        new Chart(document.getElementById('priorityChart'), {
            type: 'doughnut',
            data: {
                labels: priorityLabels,
                datasets: [{
                    data: priorityValues,
                    backgroundColor: colorsFor(priorityLabels),
                    borderColor: '#ffffff',
                    borderWidth: 3,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // ---------- Status (pie) ----------
        new Chart(document.getElementById('statusChart'), {
            type: 'pie',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusValues,
                    backgroundColor: colorsFor(statusLabels),
                    borderColor: '#ffffff',
                    borderWidth: 3,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // ---------- Ticket trend (line with gradient area) ----------
        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: 'Created Tickets',
                    data: trendValues,
                    borderColor: palette.indigo,
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true,
                    backgroundColor: function (context) {
                        const chart = context.chart;
                        const area = chart.chartArea;
                        if (!area) {
                            return 'rgba(79, 70, 229, 0.12)';
                        }
                        const gradient = chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
                        gradient.addColorStop(0, 'rgba(79, 70, 229, 0.28)');
                        gradient.addColorStop(1, 'rgba(124, 58, 237, 0)');
                        return gradient;
                    },
                    pointRadius: 3,
                    pointHoverRadius: 6,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: palette.indigo,
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { display: false } },
                scales: verticalScales()
            }
        });

        // ---------- Department (horizontal bar) ----------
        new Chart(document.getElementById('departmentChart'), {
            type: 'bar',
            data: {
                labels: departmentLabels,
                datasets: [{
                    label: 'Total Tickets',
                    data: departmentValues,
                    backgroundColor: 'rgba(99, 102, 241, 0.85)',
                    hoverBackgroundColor: palette.violet,
                    borderRadius: 8,
                    borderSkipped: false,
                    maxBarThickness: 28
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: {
                        beginAtZero: true,
                        border: { display: false },
                        grid: { color: gridColor },
                        ticks: { precision: 0 }
                    },
                    y: { grid: { display: false }, border: { display: false } }
                }
            }
        });

        // ---------- Reopen Request Trends ----------
        new Chart(document.getElementById('reopenTrendChart'), {
            type: 'line',
            data: {
                labels: reopenTrendLabels,
                datasets: [
                    lineDataset('Pending', reopenPendingValues, palette.amber, 'rgba(245, 158, 11, 0.08)'),
                    lineDataset('Approved', reopenApprovedValues, palette.green, 'rgba(34, 197, 94, 0.08)'),
                    lineDataset('Rejected', reopenRejectedValues, palette.red, 'rgba(239, 68, 68, 0.08)')
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { position: 'bottom' } },
                scales: verticalScales()
            }
        });

        // ---------- SLA Breaches by Priority ----------
        new Chart(document.getElementById('slaPriorityChart'), {
            type: 'bar',
            data: {
                labels: slaPriorityData.map(x => priorityName(x.priority)),
                datasets: [
                    {
                        label: 'Response Breached',
                        data: slaPriorityData.map(x => x.responseBreached),
                        backgroundColor: palette.amber,
                        borderRadius: 8,
                        borderSkipped: false,
                        maxBarThickness: 32
                    },
                    {
                        label: 'Resolution Breached',
                        data: slaPriorityData.map(x => x.resolutionBreached),
                        backgroundColor: palette.red,
                        borderRadius: 8,
                        borderSkipped: false,
                        maxBarThickness: 32
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } },
                scales: verticalScales()
            }
        });

        // ---------- SLA Breach Trends ----------
        new Chart(document.getElementById('slaTrendChart'), {
            type: 'line',
            data: {
                labels: slaTrendLabels,
                datasets: [
                    lineDataset('Response Breached', slaResponseTrend, palette.amber, 'rgba(245, 158, 11, 0.08)'),
                    lineDataset('Resolution Breached', slaResolutionTrend, palette.red, 'rgba(239, 68, 68, 0.08)')
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { position: 'bottom' } },
                scales: verticalScales()
            }
        });
    </script>
}