@model ITHelpdeshMangament.Models.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var inv = System.Globalization.CultureInfo.InvariantCulture;

    double Percent(double part, double total) => total <= 0 ? 0 : Math.Round(part / total * 100, 1);
    string Width(double value) => Math.Clamp(value, 0, 100).ToString("0.#", inv);
    string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim().Substring(0, 1).ToUpperInvariant();
    string RateClass(double rate) => rate >= 90 ? "rate-good" : rate >= 70 ? "rate-warn" : "rate-bad";

    var responsePct = Percent(Model.ResponseOverdueCount, Model.TotalTicketsWithSla);
    var resolutionPct = Percent(Model.ResolutionOverdueCount, Model.TotalTicketsWithSla);
    var resolvedPct = Percent(Model.ResolvedTickets, Model.TotalTickets);
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
<script id="dashboardData" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
            priorityRaw = Model.PriorityStatistics.Select(x => x.Priority),
                priorityValues = Model.PriorityStatistics.Select(x => x.Count),

                statusRaw = Model.StatusDistribution.Select(x => x.Status),
                statusValues = Model.StatusDistribution.Select(x => x.TicketCount),

                trendLabels = Model.TicketTrends.Select(x => x.Date.ToString("yyyy-MM-dd")),
                trendValues = Model.TicketTrends.Select(x => x.TotalTickets),

                departmentLabels = Model.DepartmentStatistics.Select(x => x.DepartmentName),
                departmentValues = Model.DepartmentStatistics.Select(x => x.TotalTickets),

                reopenTrendLabels = Model.ReopenRequestTrends.Select(x => x.Date.ToString("yyyy-MM-dd")),
                reopenPendingValues = Model.ReopenRequestTrends.Select(x => x.PendingCount),
                reopenApprovedValues = Model.ReopenRequestTrends.Select(x => x.ApprovedCount),
                reopenRejectedValues = Model.ReopenRequestTrends.Select(x => x.RejectedCount),

                slaPriorityData = Model.SlaPriorityStatistics.Select(x => new
                {
                        priority = x.Priority,
                        totalBreached = x.TotalBreachedCount,
                        responseBreached = x.ResponseBreachedCount,
                        resolutionBreached = x.ResolutionBreachedCount
                }),

                slaTrendLabels = Model.SlaBreachTrends.Select(x => x.Date.ToString("yyyy-MM-dd")),
                slaResponseTrend = Model.SlaBreachTrends.Select(x => x.ResponseBreachedCount),
                slaResolutionTrend = Model.SlaBreachTrends.Select(x => x.ResolutionBreachedCount)
        }))
</script>
<div class="dash-page container-fluid py-4">

    <!-- Header -->
    <div class="dash-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div style="position: relative; z-index: 1;">
            <h2>IT Helpdesk Dashboard</h2>
            <p>Overview of ticket activities and service performance</p>
        </div>

        <span class="role-pill">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            Admin / IT Staff
        </span>
    </div>

    @if (ViewBag.ErrorMessage != null || TempData["ErrorMessage"] != null)
    {
        <div class="error-banner" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <div>@(ViewBag.ErrorMessage ?? TempData["ErrorMessage"])</div>
        </div>
    }

    <!-- ===================== Filter ===================== -->
    <form asp-controller="Dashboard" asp-action="Index" method="get" id="filterForm" class="filter-bar">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">

            <div class="d-flex align-items-center gap-3">
                <div class="filter-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                </div>
                <div>
                    <div class="filter-title">Date Range</div>
                    <div class="filter-period">
                        @Model.FromDate.ToString("MMM dd, yyyy") &ndash; @Model.ToDate.ToString("MMM dd, yyyy")
                    </div>
                </div>
            </div>

            <div class="range-toggle" role="radiogroup" aria-label="Date range">
                <input type="radio" name="range" id="rangeToday" value="Today" checked="@(Model.Range == "Today")" />
                <label for="rangeToday">Today</label>

                <input type="radio" name="range" id="range7" value="Last7Days" checked="@(Model.Range == "Last7Days")" />
                <label for="range7">Last 7 Days</label>

                <input type="radio" name="range" id="range30" value="Last30Days" checked="@(Model.Range == "Last30Days")" />
                <label for="range30">Last 30 Days</label>

                <input type="radio" name="range" id="rangeCustom" value="Custom" checked="@(Model.Range == "Custom")" />
                <label for="rangeCustom">Custom</label>
            </div>

            <div class="date-fields" id="dateFields">
                <div>
                    <label for="fromDate" class="field-label">From</label>
                    <input id="fromDate" name="fromDate" type="date" class="form-control"
                           value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                </div>
                <div>
                    <label for="toDate" class="field-label">To</label>
                    <input id="toDate" name="toDate" type="date" class="form-control"
                           value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                </div>
                <button type="submit" class="btn btn-apply">Apply</button>
            </div>

        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
    </form>

    <!-- ===================== Export Reports ===================== -->
    <div class="export-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h6>Export Dashboard Reports</h6>
                <div class="subtitle">
                    Excel reports for tickets created between
                    @Model.FromDate.ToString("MMM dd, yyyy", inv) and @Model.ToDate.ToString("MMM dd, yyyy", inv)
                </div>
            </div>
        </div>

        <div class="row g-3">

            <div class="col-12 col-md-6 col-xl-3">
                <a class="export-tile"
                   asp-controller="Dashboard"
                   asp-action="ExportSummary"
                   asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")">
                    <span class="tile-icon stat-icon indigo">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="8" y1="13" x2="16" y2="13" />
                            <line x1="8" y1="17" x2="14" y2="17" />
                        </svg>
                    </span>
                    <span>
                        <span class="tile-name d-block">Summary</span>
                        <span class="tile-desc">Ticket totals and status</span>
                    </span>
                    <svg class="tile-download" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="7 10 12 15 17 10" />
                        <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                </a>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <a class="export-tile"
                   asp-controller="Dashboard"
                   asp-action="ExportSlaPerformance"
                   asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")">
                    <span class="tile-icon stat-icon green">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            <polyline points="9 12 11 14 15 10" />
                        </svg>
                    </span>
                    <span>
                        <span class="tile-name d-block">SLA Performance</span>
                        <span class="tile-desc">Response and resolution</span>
                    </span>
                    <svg class="tile-download" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="7 10 12 15 17 10" />
                        <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                </a>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <a class="export-tile"
                   asp-controller="Dashboard"
                   asp-action="ExportStaffPerformance"
                   asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")">
                    <span class="tile-icon stat-icon amber">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </span>
                    <span>
                        <span class="tile-name d-block">Staff Performance</span>
                        <span class="tile-desc">Workload and resolution</span>
                    </span>
                    <svg class="tile-download" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="7 10 12 15 17 10" />
                        <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                </a>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <a class="export-tile"
                   asp-controller="Dashboard"
                   asp-action="ExportDepartmentPerformance"
                   asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")">
                    <span class="tile-icon stat-icon blue">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4" y="2" width="16" height="20" rx="2" />
                            <line x1="9" y1="6" x2="9.01" y2="6" />
                            <line x1="15" y1="6" x2="15.01" y2="6" />
                            <line x1="9" y1="10" x2="9.01" y2="10" />
                            <line x1="15" y1="10" x2="15.01" y2="10" />
                            <path d="M10 22v-4h4v4" />
                        </svg>
                    </span>
                    <span>
                        <span class="tile-name d-block">Department Performance</span>
                        <span class="tile-desc">Volume and SLA by team</span>
                    </span>
                    <svg class="tile-download" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="7 10 12 15 17 10" />
                        <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                </a>
            </div>

        </div>
    </div>

    <!-- ===================== Ticket Overview ===================== -->
    <div class="section-title">Ticket Overview</div>

    <div class="row g-3">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon indigo">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z" />
                            <path d="M13 5v2M13 17v2M13 11v2" />
                        </svg>
                    </div>
                    <div>
                        <div class="stat-label">Total Tickets</div>
                        <p class="stat-value">@Model.TotalTickets</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon blue">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="16" />
                            <line x1="8" y1="12" x2="16" y2="12" />
                        </svg>
                    </div>
                    <div>
                        <div class="stat-label">New Tickets</div>
                        <p class="stat-value">@Model.NewTickets</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon amber">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <polyline points="12 6 12 12 16 14" />
                        </svg>
                    </div>
                    <div>
                        <div class="stat-label">In Progress</div>
                        <p class="stat-value">@Model.InProgressTickets</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card h-100 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon green">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                            <polyline points="22 4 12 14.01 9 11.01" />
                        </svg>
                    </div>
                    <div class="flex-grow-1">
                        <div class="stat-label">Resolved Tickets</div>
                        <p class="stat-value">@Model.ResolvedTickets</p>
                    </div>
                </div>
                <div class="stat-progress mt-3">
                    <span class="bar-green" style="width: @(Width(resolvedPct))%"></span>
                </div>
                <div class="stat-hint">@resolvedPct% of all tickets</div>
            </div>
        </div>

    </div>

    <!-- ===================== SLA Performance ===================== -->
    <div class="section-title">SLA Performance</div>

    <div class="row g-3">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="stat-card h-100 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon slate">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            <polyline points="9 12 11 14 15 10" />
                        </svg>
                    </div>
                    <div>
                        <div class="stat-label">Tickets with SLA</div>
                        <p class="stat-value">@Model.TotalTicketsWithSla</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="stat-card h-100 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon red">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                            <line x1="12" y1="9" x2="12" y2="13" />
                            <line x1="12" y1="17" x2="12.01" y2="17" />
                        </svg>
                    </div>
                    <div class="flex-grow-1">
                        <div class="stat-label">Response SLA Breached</div>
                        <p class="stat-value tone-red">@Model.ResponseOverdueCount</p>
                    </div>
                </div>
                <div class="stat-progress mt-3">
                    <span class="bar-red" style="width: @(Width(responsePct))%"></span>
                </div>
                <div class="stat-hint">@responsePct% of tickets with SLA</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="stat-card h-100 p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon red">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="15" y1="9" x2="9" y2="15" />
                            <line x1="9" y1="9" x2="15" y2="15" />
                        </svg>
                    </div>
                    <div class="flex-grow-1">
                        <div class="stat-label">Resolution SLA Breached</div>
                        <p class="stat-value tone-red">@Model.ResolutionOverdueCount</p>
                    </div>
                </div>
                <div class="stat-progress mt-3">
                    <span class="bar-red" style="width: @(Width(resolutionPct))%"></span>
                </div>
                <div class="stat-hint">@resolutionPct% of tickets with SLA</div>
            </div>
        </div>

    </div>

    <!-- ===================== Ticket Analytics (charts) ===================== -->
    <div class="section-title">Ticket Analytics</div>

    <div class="row g-3">

        <div class="col-12 col-lg-6">
            <div class="chart-card h-100">
                <div class="chart-head">
                    <h6>Tickets by Priority</h6>
                    <small>Distribution across priority levels</small>
                </div>
                <div class="chart-wrapper">
                    <div class="chart-loading" id="priorityChartLoading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading chart...</span>
                        </div>
                        <span>Loading chart...</span>
                    </div>

                    <canvas id="priorityChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="chart-card h-100">
                <div class="chart-head">
                    <h6>Tickets by Status</h6>
                    <small>Current state of all tickets</small>
                </div>
                <div class="chart-body">
                    <div class="chart-wrapper">
                        <div class="chart-loading" id="statusChartLoading">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading chart...</span>
                            </div>
                            <span>Loading chart...</span>
                        </div>

                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="chart-card">
                <div class="chart-head">
                    <h6>Ticket Creation Trends</h6>
                    <small>New tickets created over time</small>
                </div>
                <div class="chart-body">
                    <div class="chart-wrapper chart-wrapper-lg">
                        <div class="chart-loading" id="trendChartLoading">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading chart...</span>
                            </div>
                            <span>Loading chart...</span>
                        </div>

                        <canvas id="trendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="chart-card">
                <div class="chart-head">
                    <h6>Tickets by Department</h6>
                    <small>Ticket volume per department</small>
                </div>
                <div class="chart-body">
                    <div class="chart-wrapper chart-wrapper-lg">
                        <div class="chart-loading" id="departmentChartLoading">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading chart...</span>
                            </div>
                            <span>Loading chart...</span>
                        </div>

                        <canvas id="departmentChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ===================== Ticket Aging ===================== -->
    <div class="section-title">Ticket Aging Analysis</div>

    <div class="row g-3">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="analytics-card accent accent-green">
                <div class="analytics-label">0&ndash;1 Day</div>
                <div class="analytics-metric tone-green">@Model.TicketAging.FromZeroToOneDay</div>
                <div class="analytics-label">Open tickets</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="analytics-card accent accent-indigo">
                <div class="analytics-label">1&ndash;3 Days</div>
                <div class="analytics-metric tone-indigo">@Model.TicketAging.FromOneToThreeDays</div>
                <div class="analytics-label">Open tickets</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="analytics-card accent accent-amber">
                <div class="analytics-label">3&ndash;7 Days</div>
                <div class="analytics-metric tone-amber">@Model.TicketAging.FromThreeToSevenDays</div>
                <div class="analytics-label">Open tickets</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="analytics-card accent accent-red">
                <div class="analytics-label">Over 7 Days</div>
                <div class="analytics-metric tone-red">@Model.TicketAging.OverSevenDays</div>
                <div class="analytics-label">Open tickets</div>
            </div>
        </div>

    </div>

    <!-- ===================== Unassigned Tickets ===================== -->
    <div class="section-title">Unassigned Tickets</div>

    <div class="row g-3">

        <div class="col-12 col-md-4">
            <div class="analytics-card accent accent-indigo">
                <div class="analytics-label">Total Unassigned Tickets</div>
                <div class="analytics-metric">@Model.UnassignedTickets.TotalUnassignedTickets</div>
                <div class="analytics-label">Waiting for an IT staff member</div>
            </div>
        </div>

        <div class="col-12 col-md-8">
            <div class="analytics-card">
                <h6>Unassigned Tickets by Priority</h6>

                <div class="row g-3 mt-1">
                    <div class="col-6 col-lg-3">
                        <div class="priority-tile low">
                            <div class="analytics-label">Low</div>
                            <div class="analytics-metric tone-green">@Model.UnassignedTickets.LowPriorityCount</div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="priority-tile medium">
                            <div class="analytics-label">Medium</div>
                            <div class="analytics-metric tone-sky">@Model.UnassignedTickets.MediumPriorityCount</div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="priority-tile high">
                            <div class="analytics-label">High</div>
                            <div class="analytics-metric tone-amber">@Model.UnassignedTickets.HighPriorityCount</div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="priority-tile critical">
                            <div class="analytics-label">Critical</div>
                            <div class="analytics-metric tone-red">@Model.UnassignedTickets.CriticalPriorityCount</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ===================== Staff Workload ===================== -->
    <div class="section-title">Staff Workload</div>

    <div class="analytics-card">
        <div class="mb-3">
            <h6>Assigned Tickets by Staff</h6>
            <div class="subtitle">Current ticket workload for each IT staff member</div>
        </div>

        <div class="analytics-scroll">
            <table class="analytics-table">
                <thead>
                    <tr>
                        <th>Staff Member</th>
                        <th class="text-number">Total Assigned</th>
                        <th class="text-number">New</th>
                        <th class="text-number">Open</th>
                        <th class="text-number">In Progress</th>
                        <th class="text-number">Pending</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.StaffWorkload.Any())
                    {
                        foreach (var staff in Model.StaffWorkload)
                        {
                            <tr>
                                <td>
                                    <div class="person-cell">
                                        <div class="avatar">@Initial(staff.FullName)</div>
                                        <div>
                                            <div class="fw-semibold">@staff.FullName</div>
                                            <div class="subtitle">@staff.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-number fw-bold">@staff.TotalAssignedTickets</td>
                                <td class="text-number">@staff.NewTickets</td>
                                <td class="text-number">@staff.OpenTickets</td>
                                <td class="text-number">@staff.InProgressTickets</td>
                                <td class="text-number">@staff.PendingTickets</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="analytics-empty">No staff workload data available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===================== Reopen Request Analytics ===================== -->
    <div class="section-title">Reopen Request Analytics</div>

    <div class="row g-3">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="analytics-card accent accent-indigo">
                <div class="analytics-label">Total Requests</div>
                <div class="analytics-metric">@Model.ReopenRequestSummary.TotalRequests</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="analytics-card accent accent-amber">
                <div class="analytics-label">Pending Requests</div>
                <div class="analytics-metric tone-amber">@Model.ReopenRequestSummary.PendingCount</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="analytics-card accent accent-green">
                <div class="analytics-label">Approved Requests</div>
                <div class="analytics-metric tone-green">@Model.ReopenRequestSummary.ApprovedCount</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="analytics-card accent accent-red">
                <div class="analytics-label">Rejected Requests</div>
                <div class="analytics-metric tone-red">@Model.ReopenRequestSummary.RejectedCount</div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="analytics-card">
                <h6>Approval Rate</h6>
                <div class="analytics-metric tone-green">@Model.ReopenRequestSummary.ApprovalRate.ToString("0.0")%</div>
                <div class="stat-progress mt-2">
                    <span class="bar-green" style="width: @(Width(Convert.ToDouble(Model.ReopenRequestSummary.ApprovalRate)))%"></span>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="analytics-card">
                <h6>Average Review Time</h6>
                <div class="analytics-metric">
                    @Model.ReopenRequestSummary.AverageReviewTimeHours.ToString("0.0")
                    <small class="fs-6 fw-normal text-muted">hours</small>
                </div>
                <div class="analytics-label">Average time required to review a request</div>
            </div>
        </div>

        <div class="col-12">
            <div class="chart-card">
                <div class="chart-head">
                    <h6>Reopen Request Trends</h6>
                    <small>Daily pending, approved and rejected requests</small>
                </div>
                <div class="chart-wrapper chart-wrapper-lg">
                    <div class="chart-loading" id="reopenTrendChartLoading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading chart...</span>
                        </div>
                        <span>Loading chart...</span>
                    </div>

                    <canvas id="reopenTrendChart"></canvas>
                </div>
            </div>
        </div>

    </div>

    <!-- ===================== SLA Advanced Analytics ===================== -->
    <div class="section-title">SLA Advanced Analytics</div>

    <div class="row g-3">

        <div class="col-12 col-lg-6">
            <div class="analytics-card">
                <h6>Response SLA Compliance</h6>
                <div class="analytics-metric tone-indigo">@Model.SlaPerformance.ResponseComplianceRate.ToString("0.0")%</div>
                <div class="stat-progress mt-2">
                    <span class="bar-indigo" style="width: @(Width(Convert.ToDouble(Model.SlaPerformance.ResponseComplianceRate)))%"></span>
                </div>
                <div class="row g-2 mt-2">
                    <div class="col-4">
                        <div class="mini-stat">
                            <div class="analytics-label">Met</div>
                            <div class="fw-bold tone-green">@Model.SlaPerformance.ResponseMetCount</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="mini-stat">
                            <div class="analytics-label">Breached</div>
                            <div class="fw-bold tone-red">@Model.SlaPerformance.ResponseBreachedCount</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="mini-stat">
                            <div class="analytics-label">Pending</div>
                            <div class="fw-bold tone-amber">@Model.SlaPerformance.ResponsePendingCount</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="analytics-card">
                <h6>Resolution SLA Compliance</h6>
                <div class="analytics-metric tone-indigo">@Model.SlaPerformance.ResolutionComplianceRate.ToString("0.0")%</div>
                <div class="stat-progress mt-2">
                    <span class="bar-indigo" style="width: @(Width(Convert.ToDouble(Model.SlaPerformance.ResolutionComplianceRate)))%"></span>
                </div>
                <div class="row g-2 mt-2">
                    <div class="col-4">
                        <div class="mini-stat">
                            <div class="analytics-label">Met</div>
                            <div class="fw-bold tone-green">@Model.SlaPerformance.ResolutionMetCount</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="mini-stat">
                            <div class="analytics-label">Breached</div>
                            <div class="fw-bold tone-red">@Model.SlaPerformance.ResolutionBreachedCount</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="mini-stat">
                            <div class="analytics-label">Pending</div>
                            <div class="fw-bold tone-amber">@Model.SlaPerformance.ResolutionPendingCount</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="analytics-card accent accent-slate">
                <h6>Total Tickets with SLA</h6>
                <div class="analytics-metric">@Model.OverdueTickets.TotalTicketsWithSla</div>
                <div class="analytics-label">Tickets currently monitored by SLA</div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="analytics-card accent accent-amber">
                <h6>Response Breached</h6>
                <div class="analytics-metric tone-red">@Model.OverdueTickets.ResponseBreachedCount</div>
                <div class="analytics-label">Tickets that missed response targets</div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="analytics-card accent accent-red">
                <h6>Resolution Breached</h6>
                <div class="analytics-metric tone-red">@Model.OverdueTickets.ResolutionBreachedCount</div>
                <div class="analytics-label">Tickets that missed resolution targets</div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="chart-card h-100">
                <div class="chart-head">
                    <h6>SLA Breaches by Priority</h6>
                    <small>Response and resolution breaches grouped by priority</small>
                </div>
                <div class="chart-wrapper chart-wrapper-lg">
                    <div class="chart-loading" id="slaPriorityChartLoading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading chart...</span>
                        </div>
                        <span>Loading chart...</span>
                    </div>

                    <canvas id="slaPriorityChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="chart-card h-100">
                <div class="chart-head">
                    <h6>SLA Breach Trends</h6>
                    <small>Daily response and resolution breaches</small>
                </div>
                <div class="chart-wrapper chart-wrapper-lg">
                    <div class="chart-loading" id="slaTrendChartLoading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading chart...</span>
                        </div>
                        <span>Loading chart...</span>
                    </div>

                    <canvas id="slaTrendChart"></canvas>
                </div>
            </div>
        </div>

    </div>

    <!-- ===================== Staff Performance ===================== -->
    <div class="section-title">Staff Performance</div>

    <div class="analytics-card">
        <div class="mb-3">
            <h6>Staff Resolution Performance</h6>
            <div class="subtitle">Ticket resolution, response time and SLA compliance by staff member</div>
        </div>

        <div class="analytics-scroll">
            <table class="analytics-table">
                <thead>
                    <tr>
                        <th>Staff Member</th>
                        <th>Department</th>
                        <th class="text-number">Assigned</th>
                        <th class="text-number">Resolved</th>
                        <th class="text-number">Avg. Resolution (h)</th>
                        <th class="text-number">Avg. First Response (h)</th>
                        <th class="text-number">SLA Compliance</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.StaffPerformance.Any())
                    {
                        foreach (var staff in Model.StaffPerformance)
                        {
                            var staffRate = Convert.ToDouble(staff.ResolutionSlaComplianceRate);

                            <tr>
                                <td>
                                    <div class="person-cell">
                                        <div class="avatar">@Initial(staff.FullName)</div>
                                        <div>
                                            <div class="fw-semibold">@staff.FullName</div>
                                            <div class="subtitle">@staff.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@staff.DepartmentName</td>
                                <td class="text-number">@staff.TotalAssignedTickets</td>
                                <td class="text-number">@staff.ResolvedTickets</td>
                                <td class="text-number">@staff.AverageResolutionTimeHours.ToString("0.0")</td>
                                <td class="text-number">@staff.AverageFirstResponseTimeHours.ToString("0.0")</td>
                                <td class="text-number">
                                    <span class="rate-pill @RateClass(staffRate)">@staffRate.ToString("0.0")%</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="analytics-empty">No staff performance data available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===================== Department Performance ===================== -->
    <div class="section-title">Department Performance</div>

    <div class="analytics-card">
        <div class="mb-3">
            <h6>Department Overview</h6>
            <div class="subtitle">Ticket distribution, resolution time and SLA compliance by department</div>
        </div>

        <div class="analytics-scroll">
            <table class="analytics-table">
                <thead>
                    <tr>
                        <th>Department</th>
                        <th class="text-number">Total Tickets</th>
                        <th class="text-number">Assigned</th>
                        <th class="text-number">Unassigned</th>
                        <th class="text-number">Resolved</th>
                        <th class="text-number">Avg. Resolution (h)</th>
                        <th class="text-number">Avg. First Response (h)</th>
                        <th class="text-number">SLA Compliance</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DepartmentPerformance.Any())
                    {
                        foreach (var department in Model.DepartmentPerformance)
                        {
                            var departmentRate = Convert.ToDouble(department.ResolutionSlaComplianceRate);

                            <tr>
                                <td class="fw-semibold">@department.DepartmentName</td>
                                <td class="text-number">@department.TotalTickets</td>
                                <td class="text-number">@department.AssignedTickets</td>
                                <td class="text-number">@department.UnassignedTickets</td>
                                <td class="text-number">@department.ResolvedTickets</td>
                                <td class="text-number">@department.AverageResolutionTimeHours.ToString("0.0")</td>
                                <td class="text-number">@department.AverageFirstResponseTimeHours.ToString("0.0")</td>
                                <td class="text-number">
                                    <span class="rate-pill @RateClass(departmentRate)">@departmentRate.ToString("0.0")%</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="analytics-empty">No department performance data available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
