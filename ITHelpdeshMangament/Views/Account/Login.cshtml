@model ITHelpdeshMangament.Models.Auth.LoginViewModel

@{
    ViewData["Title"] = "Sign in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - IT Helpdesk</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --text: #111827;
            --muted: #6b7280;
            --border: #e5e7eb;
            --danger: #dc2626;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
            color: var(--text);
            background: #fff;
        }

        .auth-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* ---------- Left brand panel ---------- */
        .brand-panel {
            flex: 1.1;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 48px 56px;
            color: #fff;
            overflow: hidden;
            background: linear-gradient(135deg, #312e81 0%, #4f46e5 50%, #7c3aed 100%);
        }

            .brand-panel::before,
            .brand-panel::after {
                content: "";
                position: absolute;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.08);
            }

            .brand-panel::before {
                width: 420px;
                height: 420px;
                top: -140px;
                right: -140px;
            }

            .brand-panel::after {
                width: 300px;
                height: 300px;
                bottom: -100px;
                left: -80px;
            }

        .brand-logo {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.25rem;
            font-weight: 700;
        }

            .brand-logo .logo-icon {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                display: grid;
                place-items: center;
                background: rgba(255, 255, 255, 0.18);
                backdrop-filter: blur(6px);
            }

        .brand-content {
            position: relative;
            z-index: 1;
            max-width: 460px;
        }

            .brand-content h1 {
                font-size: 2.4rem;
                font-weight: 700;
                line-height: 1.2;
                margin-bottom: 16px;
            }

            .brand-content p {
                font-size: 1.05rem;
                opacity: 0.85;
                margin-bottom: 28px;
            }

        .feature-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .feature-list li {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 14px;
                font-weight: 500;
            }

            .feature-list .check {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                display: grid;
                place-items: center;
                background: rgba(255, 255, 255, 0.2);
                flex-shrink: 0;
            }

        .brand-footer {
            position: relative;
            z-index: 1;
            font-size: 0.85rem;
            opacity: 0.7;
        }

        /* ---------- Right form panel ---------- */
        .form-panel {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
            background: #f9fafb;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 40px 36px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 20px;
            box-shadow: 0 20px 45px -15px rgba(17, 24, 39, 0.12);
            animation: fadeUp 0.5s ease both;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(14px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-card h2 {
            font-size: 1.65rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .login-card .subtitle {
            color: var(--muted);
            margin-bottom: 28px;
        }

        .form-label {
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .input-group-modern {
            position: relative;
        }

            .input-group-modern .input-icon {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #9ca3af;
                pointer-events: none;
                display: flex;
            }

            .input-group-modern .form-control {
                height: 48px;
                padding-left: 44px;
                border: 1.5px solid var(--border);
                border-radius: 12px;
                font-size: 0.95rem;
                background: #fff;
                transition: border-color 0.15s, box-shadow 0.15s;
            }

                .input-group-modern .form-control:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.15);
                }

                .input-group-modern .form-control.input-validation-error {
                    border-color: var(--danger);
                }

                    .input-group-modern .form-control.input-validation-error:focus {
                        box-shadow: 0 0 0 4px rgba(220, 38, 38, 0.12);
                    }

                .input-group-modern .form-control.has-toggle {
                    padding-right: 46px;
                }

        .toggle-password {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            padding: 8px;
            color: #9ca3af;
            border-radius: 8px;
            display: flex;
            cursor: pointer;
        }

            .toggle-password:hover {
                color: var(--primary);
                background: #f3f4f6;
            }

        .field-validation-error,
        .text-danger {
            color: var(--danger) !important;
            font-size: 0.82rem;
            margin-top: 6px;
            display: block;
        }

        .validation-summary-errors {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 18px;
            }

        .validation-summary-valid {
            display: none;
        }

        .btn-login {
            height: 48px;
            border: 0;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1rem;
            color: #fff;
            background: linear-gradient(135deg, var(--primary), #7c3aed);
            box-shadow: 0 10px 20px -8px rgba(79, 70, 229, 0.6);
            transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
        }

            .btn-login:hover {
                transform: translateY(-1px);
                box-shadow: 0 14px 24px -8px rgba(79, 70, 229, 0.7);
                color: #fff;
            }

            .btn-login:disabled {
                opacity: 0.75;
                transform: none;
                cursor: not-allowed;
            }

        .card-footer-text {
            margin-top: 28px;
            text-align: center;
            font-size: 0.82rem;
            color: var(--muted);
        }

        @@media (max-width: 991.98px) {
            .brand-panel {
                display: none;
            }

            .form-panel {
                background: linear-gradient(135deg, #eef2ff, #f5f3ff);
            }
        }

        @@media (max-width: 480px) {
            .login-card {
                padding: 32px 22px;
                border-radius: 16px;
            }
        }
    </style>
</head>

<body>
    <div class="auth-wrapper">

        <!-- Brand panel -->
        <section class="brand-panel">
            <div class="brand-logo">
                <span class="logo-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 18v-6a9 9 0 0 1 18 0v6" />
                        <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" />
                    </svg>
                </span>
                IT Helpdesk
            </div>

            <div class="brand-content">
                <h1>Manage support tickets, faster and smarter.</h1>
                <p>A single place to track requests, assign technicians and keep your IT operations running smoothly.</p>

                <ul class="feature-list">
                    <li>
                        <span class="check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                        </span>
                        Real-time ticket tracking
                    </li>
                    <li>
                        <span class="check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                        </span>
                        Assign and prioritize tasks easily
                    </li>
                    <li>
                        <span class="check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                        </span>
                        Secure, role-based access
                    </li>
                </ul>
            </div>

            <div class="brand-footer">&copy; @DateTime.Now.Year IT Helpdesk Management System</div>
        </section>

        <!-- Form panel -->
        <section class="form-panel">
            <div class="login-card">
                <h2>Welcome back</h2>
                <p class="subtitle">Sign in to your admin account to continue.</p>

                <form asp-controller="Account" asp-action="Login" method="post" id="loginForm" novalidate>

                    <div asp-validation-summary="ModelOnly"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <div class="input-group-modern">
                            <span class="input-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="4" width="20" height="16" rx="2" />
                                    <path d="m22 7-10 6L2 7" />
                                </svg>
                            </span>
                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="name@company.com"
                                   autocomplete="username"
                                   autofocus />
                        </div>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-group-modern">
                            <span class="input-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                            </span>
                            <input asp-for="Password"
                                   class="form-control has-toggle"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />
                            <button type="button" class="toggle-password" id="togglePassword" aria-label="Show or hide password">
                                <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="btn btn-login w-100" id="submitBtn">
                        <span class="btn-text">Sign in</span>
                        <span class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
                    </button>
                </form>

                <div class="card-footer-text">
                    Protected area &middot; Authorized personnel only
                </div>
            </div>
        </section>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        (function () {
            var pwd = document.getElementById('Password');
            var toggle = document.getElementById('togglePassword');
            var eye = document.getElementById('eyeIcon');

            var eyeOpen = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
            var eyeOff = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';

            toggle.addEventListener('click', function () {
                var show = pwd.type === 'password';
                pwd.type = show ? 'text' : 'password';
                eye.innerHTML = show ? eyeOff : eyeOpen;
            });

            // Loading state on valid submit
            var form = document.getElementById('loginForm');
            var btn = document.getElementById('submitBtn');

            form.addEventListener('submit', function () {
                if (window.jQuery && jQuery(form).valid && !jQuery(form).valid()) return;
                btn.disabled = true;
                btn.querySelector('.btn-text').textContent = 'Signing in...';
                btn.querySelector('.spinner-border').classList.remove('d-none');
            });
        })();
    </script>
</body>
</html>