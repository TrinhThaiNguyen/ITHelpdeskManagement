@model ITHelpdeshMangament.Models.Tickets.TicketDetailsViewModel

@{
    ViewData["Title"] = "Ticket Details";

    var inv = System.Globalization.CultureInfo.InvariantCulture;

    string GetStatusLabel(int status) => status switch
    {
        1 => "New",
        2 => "Open",
        3 => "In Progress",
        4 => "Pending",
        5 => "Resolved",
        6 => "Closed",
        _ => "Unknown"
    };

    string GetPriorityLabel(int priority) => priority switch
    {
        1 => "Low",
        2 => "Medium",
        3 => "High",
        4 => "Critical",
        _ => "Unknown"
    };

    var canManageAssignee =
        Context.Session.GetString("Roles")?.Contains("Admin") == true ||
        Context.Session.GetString("Roles")?.Contains("ITStaff") == true;

    var assigneeInitial = string.IsNullOrWhiteSpace(Model.AssigneeName)
        ? "?"
        : Model.AssigneeName.Trim()[0].ToString().ToUpperInvariant();

    var statusName = GetStatusLabel(Model.Status);
    var priorityName = GetPriorityLabel(Model.Priority);

    var statusClass = Model.Status switch
    {
        1 => "st-new",
        2 => "st-open",
        3 => "st-progress",
        4 => "st-pending",
        5 => "st-resolved",
        6 => "st-closed",
        _ => "st-pending"
    };

    var priorityClass = Model.Priority switch
    {
        1 => "pr-low",
        2 => "pr-medium",
        3 => "pr-high",
        4 => "pr-critical",
        _ => "pr-medium"
    };

    var allowedNextStatuses = Model.Status switch
    {
        1 => new[] { 2 },
        2 => new[] { 3 },
        3 => new[] { 4, 5 },
        4 => new[] { 3, 5 },
        5 => new[] { 6 },
        _ => Array.Empty<int>()
    };

    string FormatDate(DateTime? date) =>
        date.HasValue
            ? date.Value.ToLocalTime().ToString("MMM dd, yyyy, HH:mm", inv)
            : "Not available";

    Microsoft.AspNetCore.Html.IHtmlContent Icon(string name, int size = 18)
    {
        var path = name switch
        {
            "back" => "<line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"/><polyline points=\"12 19 5 12 12 5\"/>",
            "edit" => "<path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z\"/>",
            "ticket" => "<path d=\"M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z\"/><path d=\"M13 5v2M13 17v2M13 11v2\"/>",
            "refresh" => "<polyline points=\"23 4 23 10 17 10\"/><path d=\"M20.49 15a9 9 0 1 1-2.12-9.36L23 10\"/>",
            "chat" => "<path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/>",
            "clock" => "<circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/>",
            "folder" => "<path d=\"M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z\"/>",
            "users" => "<path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/>",
            "shield" => "<path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><polyline points=\"9 12 11 14 15 10\"/>",
            "send" => "<line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"/><polygon points=\"22 2 15 22 11 13 2 9 22 2\"/>",
            "lock" => "<rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/>",
            "check" => "<polyline points=\"20 6 9 17 4 12\"/>",
            "alert" => "<circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/>",
            "arrow" => "<line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/><polyline points=\"12 5 19 12 12 19\"/>",
            "activity" => "<polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/>",
            _ => string.Empty
        };

        return Html.Raw($"<svg width=\"{size}\" height=\"{size}\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{path}</svg>");
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/ticket-details.css" asp-append-version="true" />
}

<div class="td-page">

    <!-- Header -->
    <div class="td-header d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <a asp-action="Index" class="back-link">
                @Icon("back", 14)
                Back to Tickets
            </a>

            <h1>Ticket Details</h1>

            <div class="ticket-ref">
                Ticket ID <code>@Model.Id</code>
            </div>
        </div>

        <div class="header-actions">
            <span class="pill @statusClass">@statusName</span>
            <span class="pill @priorityClass">@priorityName</span>

            <a asp-action="Edit"
               asp-controller="Tickets"
               asp-route-id="@Model.Id"
               class="btn-edit">
                @Icon("edit", 16)
                Edit Ticket
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="notice notice-success alert alert-dismissible fade show" role="alert">
            @Icon("check", 20)
            <div class="notice-body">@successMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="notice notice-error alert alert-dismissible fade show" role="alert">
            @Icon("alert", 20)
            <div class="notice-body">@errorMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Status lifecycle -->
    <div class="stepper" aria-label="Ticket lifecycle">
        @for (var step = 1; step <= 6; step++)
        {
            var stepClass = step < Model.Status ? "done" : step == Model.Status ? "current" : "";

            <div class="step @stepClass">
                <div class="step-dot">
                    @if (step < Model.Status)
                    {
                        @Icon("check", 14)
                    }
                    else
                    {
                        @step
                    }
                </div>
                <div class="step-label">@GetStatusLabel(step)</div>
            </div>
        }
    </div>

    <div class="td-grid">

        <!-- ========== Main column ========== -->
        <div class="td-col">

            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon">@Icon("ticket")</span>
                    <h2>Ticket Information</h2>
                </div>

                <h3 class="ticket-title">@Model.Title</h3>

                <div class="field">
                    <span class="field-label">Description</span>
                    <div class="description-box">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</div>
                </div>
            </section>

            <!-- Comments -->
            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon sky">@Icon("chat")</span>
                    <h2>Comments</h2>
                    <span class="count-chip">@Model.Comments.Count</span>
                </div>

                <form asp-action="AddComment"
                      asp-controller="Tickets"
                      method="post"
                      class="comment-form">

                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="field">
                        <label for="content" class="field-label">Add a comment</label>
                        <textarea id="content"
                                  name="content"
                                  rows="4"
                                  maxlength="2000"
                                  placeholder="Write your comment..."
                                  required></textarea>
                    </div>

                    <div class="comment-form-footer">
                        <label class="internal-option">
                            <input type="checkbox" name="isInternal" value="true" />
                            @Icon("lock", 14)
                            Internal comment
                        </label>

                        <button type="submit" class="btn-gradient">
                            @Icon("send", 16)
                            Add Comment
                        </button>
                    </div>
                </form>

                <div class="comments-list">
                    @if (Model.Comments.Count > 0)
                    {
                        foreach (var comment in Model.Comments.OrderByDescending(x => x.CreatedAt))
                        {
                            <article class="comment-item @(comment.IsInternal ? "internal" : "")">
                                <div class="comment-meta">
                                    <span>@comment.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy, HH:mm", inv)</span>

                                    @if (comment.IsInternal)
                                    {
                                        <span class="internal-badge">
                                            @Icon("lock", 11)
                                            Internal
                                        </span>
                                    }
                                </div>

                                <p class="comment-content">@comment.Content</p>
                            </article>
                        }
                    }
                    else
                    {
                        <p class="empty-section">No comments yet.</p>
                    }
                </div>
            </section>

            <!-- Activity history -->
            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon violet">@Icon("activity")</span>
                    <h2>Activity History</h2>
                    <span class="count-chip">@Model.Histories.Count</span>
                </div>

                @if (Model.Histories.Count > 0)
                {
                    <div class="history-list">
                        @foreach (var history in Model.Histories.OrderByDescending(x => x.CreatedAt))
                        {
                            <article class="history-item">
                                <div class="history-marker"></div>

                                <div class="history-content">
                                    <div class="history-meta">
                                        <strong>@history.Action</strong>
                                        <span>@history.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy, HH:mm", inv)</span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(history.ChangedBy))
                                    {
                                        <p class="history-actor">By @history.ChangedBy</p>
                                    }

                                    @if (history.OldValue is not null || history.NewValue is not null)
                                    {
                                        <div class="history-change">
                                            @if (history.OldValue is not null)
                                            {
                                                <span class="change-chip old">@history.OldValueDisplay</span>
                                            }

                                            @if (history.OldValue is not null && history.NewValue is not null)
                                            {
                                                <span class="change-arrow">@Icon("arrow", 14)</span>
                                            }

                                            @if (history.NewValue is not null)
                                            {
                                                <span class="change-chip new">@history.NewValueDisplay</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p class="empty-section">No activity history available.</p>
                }
            </section>

        </div>

        <!-- ========== Sidebar ========== -->
        <aside class="td-col">

            @if (allowedNextStatuses.Length > 0)
            {
                <section class="td-card">
                    <div class="card-head">
                        <span class="card-icon green">@Icon("refresh")</span>
                        <h2>Update Status</h2>
                    </div>

                    <form asp-action="ChangeStatus"
                          asp-controller="Tickets"
                          method="post"
                          class="status-form">

                        <input type="hidden" name="id" value="@Model.Id" />

                        <select name="status" class="form-select" aria-label="New status" required>
                            @foreach (var nextStatus in allowedNextStatuses)
                            {
                                <option value="@nextStatus">@GetStatusLabel(nextStatus)</option>
                            }
                        </select>

                        <button type="submit" class="btn-gradient">
                            @Icon("check", 16)
                            Update Status
                        </button>
                    </form>
                </section>
            }

            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon amber">@Icon("folder")</span>
                    <h2>Classification</h2>
                </div>

                <div class="field">
                    <span class="field-label">Category</span>
                    <p class="field-value">@Model.CategoryName</p>
                </div>

                <div class="field">
                    <span class="field-label">Department</span>
                    <p class="field-value">@Model.DepartmentName</p>
                </div>
            </section>

            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon sky">@Icon("users")</span>
                    <h2>People</h2>
                </div>

                <div class="field">
                    <span class="field-label">Requester ID</span>
                    <p class="field-value mono">@Model.RequesterId</p>
                </div>

                <div class="field">
                    <span class="field-label">Assigned To</span>

                    @if (Model.AssigneeId is null)
                    {
                        <span class="pill pill-muted">Unassigned</span>
                    }
                    else
                    {
                        <div class="assignee">
                            <span class="avatar">@assigneeInitial</span>
                            <div class="assignee-info">
                                <strong>@Model.AssigneeName</strong>
                                <span>@Model.AssigneeEmail</span>
                                @if (Model.AssignedAt.HasValue)
                                {
                                    <small>Assigned @FormatDate(Model.AssignedAt)</small>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (canManageAssignee)
                {
                    <div class="assign-panel">
                        <form asp-action="Assign"
                              asp-controller="Tickets"
                              method="post"
                              class="status-form">

                            <input type="hidden" name="id" value="@Model.Id" />

                            <label for="assigneeSelect" class="field-label">
                                @(Model.AssigneeId is null ? "Assign to" : "Reassign to")
                            </label>

                            <select id="assigneeSelect" name="AssigneeId" class="form-select" required>
                                <option value="">-- Select IT Staff --</option>
                                @foreach (var staff in Model.AvailableAssignees)
                                {
                                    <option value="@staff.Id" selected="@(Model.AssigneeId == staff.Id)">
                                        @staff.FullName - @staff.Email
                                    </option>
                                }
                            </select>

                            <button type="submit" class="btn-gradient">
                                @Icon("users", 16)
                                @(Model.AssigneeId is null ? "Assign Ticket" : "Reassign Ticket")
                            </button>
                        </form>

                        @if (Model.AssigneeId.HasValue)
                        {
                            <form asp-action="Unassign"
                                  asp-controller="Tickets"
                                  method="post"
                                  class="status-form"
                                  onsubmit="return confirm('Remove the current assignee from this ticket?');">

                                <input type="hidden" name="id" value="@Model.Id" />

                                <button type="submit" class="btn-danger-soft">
                                    Unassign Ticket
                                </button>
                            </form>
                        }
                    </div>
                }
            </section>

            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon violet">@Icon("clock")</span>
                    <h2>Timeline</h2>
                </div>

                <div class="field">
                    <span class="field-label">Created At</span>
                    <p class="field-value">@FormatDate(Model.CreatedAt)</p>
                </div>

                <div class="field">
                    <span class="field-label">Last Updated</span>
                    <p class="field-value">@FormatDate(Model.UpdatedAt)</p>
                </div>
            </section>


            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon green">@Icon("shield")</span>
                    <h2>SLA Information</h2>
                </div>

                @if (Model.Sla is not null)
                {
                    var nowUtc = DateTime.UtcNow;

                    var isTicketCompleted =
                        Model.Status == 5 || Model.Status == 6;

                    var responseCompleted =
                        Model.Sla.FirstResponseAt.HasValue;

                    var responseBreached =
                        Model.Sla.ResponseBreached ||
                        (!responseCompleted &&
                         (Model.Sla.ResponseDeadline < nowUtc ||
                          isTicketCompleted));

                    var resolutionCompleted =
                        Model.Sla.ResolvedAt.HasValue;

                    var resolutionBreached =
                        Model.Sla.ResolutionBreached ||
                        (!resolutionCompleted &&
                         Model.Sla.ResolutionDeadline < nowUtc &&
                         !isTicketCompleted);

                    var responseStatus = responseCompleted
                        ? (responseBreached ? "Completed late" : "Met")
                        : (responseBreached ? "Breached" : "Within SLA");

                    var responseClass =
                        responseBreached ? "sla-breached" : "sla-normal";

                    var resolutionStatus = resolutionCompleted
                        ? (resolutionBreached ? "Completed late" : "Met")
                        : resolutionBreached
                            ? "Breached"
                            : isTicketCompleted
                                ? "Completed (time unavailable)"
                                : "Within SLA";

                    var resolutionClass =
                        resolutionBreached ? "sla-breached" : "sla-normal";

                    <div class="sla-policy">
                        <span>SLA Policy</span>
                        <strong>@Model.Sla.SlaPolicyName</strong>
                    </div>

                    <div class="sla-item">
                        <span class="field-label">Response Deadline</span>
                        <p class="field-value">
                            @FormatDate(Model.Sla.ResponseDeadline)
                        </p>

                        <span class="sla-result @responseClass">
                            @responseStatus
                        </span>
                    </div>

                    <div class="sla-item">
                        <span class="field-label">Resolution Deadline</span>
                        <p class="field-value">
                            @FormatDate(Model.Sla.ResolutionDeadline)
                        </p>

                        <span class="sla-result @resolutionClass">
                            @resolutionStatus
                        </span>
                    </div>

                    <div class="sla-item">
                        <span class="field-label">First Response At</span>
                        <p class="field-value">
                            @FormatDate(Model.Sla.FirstResponseAt)
                        </p>
                    </div>

                    <div class="sla-item">
                        <span class="field-label">Resolved At</span>
                        <p class="field-value">
                            @FormatDate(Model.Sla.ResolvedAt)
                        </p>
                    </div>
                }
                else
                {
                    <p class="empty-section">
                        No SLA information available for this ticket.
                    </p>
                }
            </section>


        </aside>

    </div>
</div>