@model ITHelpdeshMangament.Models.Tickets.TicketDetailsViewModel

@{
    ViewData["Title"] = "Ticket Details";

    var inv = System.Globalization.CultureInfo.InvariantCulture;

    string GetStatusLabel(int status) => status switch
    {
        1 => "New",
        2 => "Open",
        3 => "In Progress",
        4 => "Pending",
        5 => "Resolved",
        6 => "Closed",
        _ => "Unknown"
    };

    string GetPriorityLabel(int priority) => priority switch
    {
        1 => "Low",
        2 => "Medium",
        3 => "High",
        4 => "Critical",
        _ => "Unknown"
    };

    var statusName = GetStatusLabel(Model.Status);
    var priorityName = GetPriorityLabel(Model.Priority);

    var statusClass = Model.Status switch
    {
        1 => "st-new",
        2 => "st-open",
        3 => "st-progress",
        4 => "st-pending",
        5 => "st-resolved",
        6 => "st-closed",
        _ => "st-pending"
    };

    var priorityClass = Model.Priority switch
    {
        1 => "pr-low",
        2 => "pr-medium",
        3 => "pr-high",
        4 => "pr-critical",
        _ => "pr-medium"
    };

    var allowedNextStatuses = Model.Status switch
    {
        1 => new[] { 2 },
        2 => new[] { 3 },
        3 => new[] { 4, 5 },
        4 => new[] { 3, 5 },
        5 => new[] { 6 },
        _ => Array.Empty<int>()
    };

    string FormatDate(DateTime? date) =>
        date.HasValue
            ? date.Value.ToLocalTime().ToString("MMM dd, yyyy, HH:mm", inv)
            : "Not available";

    Microsoft.AspNetCore.Html.IHtmlContent Icon(string name, int size = 18)
    {
        var path = name switch
        {
            "back" => "<line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"/><polyline points=\"12 19 5 12 12 5\"/>",
            "edit" => "<path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z\"/>",
            "ticket" => "<path d=\"M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z\"/><path d=\"M13 5v2M13 17v2M13 11v2\"/>",
            "refresh" => "<polyline points=\"23 4 23 10 17 10\"/><path d=\"M20.49 15a9 9 0 1 1-2.12-9.36L23 10\"/>",
            "chat" => "<path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/>",
            "clock" => "<circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/>",
            "folder" => "<path d=\"M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z\"/>",
            "users" => "<path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/>",
            "shield" => "<path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><polyline points=\"9 12 11 14 15 10\"/>",
            "send" => "<line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"/><polygon points=\"22 2 15 22 11 13 2 9 22 2\"/>",
            "lock" => "<rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/>",
            "check" => "<polyline points=\"20 6 9 17 4 12\"/>",
            "alert" => "<circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/>",
            "arrow" => "<line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/><polyline points=\"12 5 19 12 12 19\"/>",
            "activity" => "<polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/>",
            _ => string.Empty
        };

        return Html.Raw($"<svg width=\"{size}\" height=\"{size}\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{path}</svg>");
    }
}

@section Styles {
    <style>
        .td-page {
            --radius: 16px;
            padding: 24px 0;
        }

        /* ---------- Header ---------- */
        .td-header {
            position: relative;
            overflow: hidden;
            border-radius: 20px;
            padding: 28px 32px;
            color: #fff;
            background: linear-gradient(135deg, #312e81 0%, #4f46e5 55%, #7c3aed 100%);
            box-shadow: 0 18px 35px -18px rgba(79, 70, 229, 0.7);
        }

            .td-header::after {
                content: "";
                position: absolute;
                width: 280px;
                height: 280px;
                right: -80px;
                top: -120px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.1);
            }

            .td-header > * {
                position: relative;
                z-index: 1;
            }

            .td-header h1 {
                font-size: 1.7rem;
                font-weight: 700;
                margin: 10px 0 8px;
            }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 0.82rem;
            font-weight: 600;
            color: #fff;
            text-decoration: none;
            background: rgba(255, 255, 255, 0.16);
            transition: background 0.15s;
        }

            .back-link:hover {
                color: #fff;
                background: rgba(255, 255, 255, 0.28);
            }

        .ticket-ref {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.82rem;
            opacity: 0.9;
        }

            .ticket-ref code {
                padding: 2px 10px;
                border-radius: 8px;
                font-size: 0.78rem;
                color: #fff;
                background: rgba(255, 255, 255, 0.18);
                word-break: break-all;
            }

        .header-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
        }

        .btn-edit {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            height: 40px;
            padding: 0 18px;
            border: 0;
            border-radius: 10px;
            font-size: 0.88rem;
            font-weight: 600;
            color: #4f46e5;
            background: #fff;
            text-decoration: none;
            box-shadow: 0 10px 20px -10px rgba(17, 24, 39, 0.5);
            transition: transform 0.15s, box-shadow 0.15s;
        }

            .btn-edit:hover {
                color: #4338ca;
                transform: translateY(-1px);
            }

        /* ---------- Pills ---------- */
        .pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px;
            border-radius: 999px;
            font-size: 0.8rem;
            font-weight: 600;
            white-space: nowrap;
        }

            .pill::before {
                content: "";
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: currentColor;
            }

            .pill.st-new      { background: #e0f2fe; color: #0369a1; }
            .pill.st-open     { background: #eef2ff; color: #4338ca; }
            .pill.st-progress { background: #fef3c7; color: #b45309; }
            .pill.st-pending  { background: #f1f5f9; color: #475569; }
            .pill.st-resolved { background: #dcfce7; color: #15803d; }
            .pill.st-closed   { background: #f3e8ff; color: #7e22ce; }

            .pill.pr-low      { background: #dcfce7; color: #15803d; }
            .pill.pr-medium   { background: #e0f2fe; color: #0369a1; }
            .pill.pr-high     { background: #fef3c7; color: #b45309; }
            .pill.pr-critical { background: #fee2e2; color: #b91c1c; }

            .pill.pill-muted  { background: #f1f5f9; color: #64748b; }

        /* ---------- Notices ---------- */
        .notice {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin: 20px 0 0;
            padding: 14px 18px;
            border-radius: 14px;
            border: 1px solid;
            font-size: 0.9rem;
        }

            .notice .notice-body {
                flex: 1;
            }

            .notice.notice-success {
                color: #15803d;
                background: #f0fdf4;
                border-color: #bbf7d0;
            }

            .notice.notice-error {
                color: #b91c1c;
                background: #fef2f2;
                border-color: #fecaca;
            }

            .notice .btn-close {
                position: static;
                padding: 4px;
                font-size: 0.7rem;
            }

        /* ---------- Status stepper ---------- */
        .stepper {
            display: flex;
            align-items: flex-start;
            margin-top: 20px;
            padding: 20px 24px;
            border: 1px solid #eef0f4;
            border-radius: var(--radius);
            background: #fff;
            box-shadow: 0 6px 18px -10px rgba(17, 24, 39, 0.15);
            overflow-x: auto;
        }

        .step {
            position: relative;
            flex: 1;
            min-width: 92px;
            text-align: center;
        }

            .step::before {
                content: "";
                position: absolute;
                top: 15px;
                left: -50%;
                width: 100%;
                height: 3px;
                border-radius: 3px;
                background: #e5e7eb;
            }

            .step:first-child::before {
                display: none;
            }

            .step.done::before,
            .step.current::before {
                background: linear-gradient(90deg, #4f46e5, #7c3aed);
            }

        .step-dot {
            position: relative;
            z-index: 1;
            width: 32px;
            height: 32px;
            margin: 0 auto 8px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 0.78rem;
            font-weight: 700;
            color: #9ca3af;
            background: #fff;
            border: 2px solid #e5e7eb;
        }

        .step.done .step-dot {
            color: #fff;
            border-color: transparent;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
        }

        .step.current .step-dot {
            color: #4f46e5;
            border-color: #4f46e5;
            box-shadow: 0 0 0 5px rgba(79, 70, 229, 0.15);
        }

        .step-label {
            font-size: 0.78rem;
            font-weight: 500;
            color: #9ca3af;
        }

        .step.done .step-label {
            color: #6b7280;
        }

        .step.current .step-label {
            font-weight: 700;
            color: #4f46e5;
        }

        /* ---------- Layout ---------- */
        .td-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 360px;
            gap: 20px;
            margin-top: 20px;
            align-items: start;
        }

        .td-col {
            display: flex;
            flex-direction: column;
            gap: 20px;
            min-width: 0;
        }

        .td-card {
            border: 1px solid #eef0f4;
            border-radius: var(--radius);
            background: #fff;
            box-shadow: 0 6px 18px -10px rgba(17, 24, 39, 0.15);
            padding: 22px 24px;
        }

        .card-head {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
        }

            .card-head h2 {
                margin: 0;
                font-size: 1rem;
                font-weight: 700;
                color: #111827;
            }

        .card-icon {
            width: 36px;
            height: 36px;
            border-radius: 11px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            background: #eef2ff;
            color: #4f46e5;
        }

            .card-icon.green  { background: #dcfce7; color: #16a34a; }
            .card-icon.amber  { background: #fef3c7; color: #d97706; }
            .card-icon.sky    { background: #e0f2fe; color: #0284c7; }
            .card-icon.violet { background: #f3e8ff; color: #7c3aed; }

        .count-chip {
            margin-left: auto;
            padding: 2px 10px;
            border-radius: 999px;
            font-size: 0.76rem;
            font-weight: 600;
            color: #6b7280;
            background: #f3f4f6;
        }

        .field {
            margin-bottom: 16px;
        }

            .field:last-child {
                margin-bottom: 0;
            }

            .field .field-label {
                display: block;
                margin-bottom: 4px;
                font-size: 0.74rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: #9ca3af;
            }

            .field .field-value {
                margin: 0;
                font-size: 0.92rem;
                font-weight: 500;
                color: #111827;
            }

        .mono {
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: 0.8rem !important;
            word-break: break-all;
        }

        /* ---------- Ticket information ---------- */
        .ticket-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #111827;
            margin: 0 0 16px;
        }

        .description-box {
            padding: 16px 18px;
            border-radius: 12px;
            background: #f9fafb;
            border: 1px solid #eef0f4;
            color: #374151;
            font-size: 0.92rem;
            line-height: 1.65;
            white-space: pre-wrap;
            word-break: break-word;
        }

        /* ---------- Update status ---------- */
        .status-form {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

            .status-form .form-select {
                height: 44px;
                border: 1.5px solid #e5e7eb;
                border-radius: 12px;
                font-size: 0.9rem;
            }

                .status-form .form-select:focus,
                .comment-form textarea:focus {
                    border-color: #4f46e5;
                    box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.15);
                    outline: none;
                }

        .btn-gradient {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            height: 44px;
            padding: 0 22px;
            border: 0;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            box-shadow: 0 10px 20px -10px rgba(79, 70, 229, 0.7);
            transition: transform 0.15s, box-shadow 0.15s;
        }

            .btn-gradient:hover {
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 14px 24px -10px rgba(79, 70, 229, 0.8);
            }

        /* ---------- Comments ---------- */
        .comment-form textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1.5px solid #e5e7eb;
            border-radius: 12px;
            font-size: 0.9rem;
            resize: vertical;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .comment-form-footer {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-top: 12px;
        }

        .internal-option {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            padding: 8px 14px;
            border: 1.5px solid #e5e7eb;
            border-radius: 10px;
            font-size: 0.84rem;
            font-weight: 500;
            color: #4b5563;
            cursor: pointer;
            transition: border-color 0.15s, background 0.15s;
        }

            .internal-option:hover {
                border-color: #fcd34d;
                background: #fffbeb;
            }

            .internal-option input {
                accent-color: #d97706;
                width: 16px;
                height: 16px;
            }

        .comments-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 22px;
            padding-top: 20px;
            border-top: 1px solid #eef0f4;
        }

        .comment-item {
            padding: 14px 16px;
            border: 1px solid #eef0f4;
            border-radius: 14px;
            background: #f9fafb;
        }

            .comment-item.internal {
                border-color: #fde68a;
                background: #fffbeb;
            }

        .comment-meta {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            margin-bottom: 6px;
            font-size: 0.78rem;
            color: #9ca3af;
        }

        .internal-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 2px 10px;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 600;
            color: #b45309;
            background: #fef3c7;
        }

        .comment-content {
            margin: 0;
            font-size: 0.9rem;
            line-height: 1.6;
            color: #374151;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .empty-section {
            margin: 0;
            padding: 24px 12px;
            text-align: center;
            font-size: 0.88rem;
            color: #9ca3af;
        }

        /* ---------- History timeline ---------- */
        .history-list {
            position: relative;
            padding-left: 6px;
        }

            .history-list::before {
                content: "";
                position: absolute;
                left: 13px;
                top: 8px;
                bottom: 8px;
                width: 2px;
                background: #e5e7eb;
            }

        .history-item {
            position: relative;
            display: flex;
            gap: 16px;
            padding-bottom: 18px;
        }

            .history-item:last-child {
                padding-bottom: 0;
            }

        .history-marker {
            position: relative;
            z-index: 1;
            width: 16px;
            height: 16px;
            margin-top: 3px;
            flex-shrink: 0;
            border-radius: 50%;
            background: #fff;
            border: 4px solid #4f46e5;
            box-shadow: 0 0 0 4px #fff;
        }

        .history-content {
            flex: 1;
            min-width: 0;
        }

        .history-meta {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            justify-content: space-between;
            gap: 8px;
        }

            .history-meta strong {
                font-size: 0.9rem;
                color: #111827;
            }

            .history-meta span {
                font-size: 0.78rem;
                color: #9ca3af;
            }

        .history-actor {
            margin: 2px 0 0;
            font-size: 0.8rem;
            color: #6b7280;
        }

        .history-change {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin-top: 8px;
            font-size: 0.8rem;
        }

        .change-chip {
            padding: 3px 10px;
            border-radius: 8px;
            word-break: break-word;
        }

            .change-chip.old {
                color: #b91c1c;
                background: #fef2f2;
                text-decoration: line-through;
                text-decoration-color: rgba(185, 28, 28, 0.4);
            }

            .change-chip.new {
                color: #15803d;
                background: #f0fdf4;
            }

        .change-arrow {
            color: #9ca3af;
            display: flex;
        }

        /* ---------- SLA ---------- */
        .sla-policy {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 14px;
            padding: 12px 14px;
            border-radius: 12px;
            background: #eef2ff;
        }

            .sla-policy span {
                font-size: 0.78rem;
                color: #6366f1;
                font-weight: 600;
            }

            .sla-policy strong {
                font-size: 0.9rem;
                color: #3730a3;
                text-align: right;
            }

        .sla-item {
            padding: 12px 14px;
            margin-bottom: 10px;
            border: 1px solid #eef0f4;
            border-radius: 12px;
        }

            .sla-item:last-child {
                margin-bottom: 0;
            }

            .sla-item .field-value {
                font-size: 0.86rem;
            }

        .sla-result {
            display: inline-block;
            margin-top: 8px;
            padding: 3px 12px;
            border-radius: 999px;
            font-size: 0.74rem;
            font-weight: 600;
        }

            .sla-result.sla-normal   { color: #15803d; background: #dcfce7; }
            .sla-result.sla-breached { color: #b91c1c; background: #fee2e2; }

        @@media (max-width: 991.98px) {
            .td-grid {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        @@media (max-width: 575.98px) {
            .td-header {
                padding: 22px 20px;
            }

            .td-card {
                padding: 18px;
            }
        }
    </style>
}

<div class="td-page">

    <!-- Header -->
    <div class="td-header d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <a asp-action="Index" class="back-link">
                @Icon("back", 14)
                Back to Tickets
            </a>

            <h1>Ticket Details</h1>

            <div class="ticket-ref">
                Ticket ID <code>@Model.Id</code>
            </div>
        </div>

        <div class="header-actions">
            <span class="pill @statusClass">@statusName</span>
            <span class="pill @priorityClass">@priorityName</span>

            <a asp-action="Edit"
               asp-controller="Tickets"
               asp-route-id="@Model.Id"
               class="btn-edit">
                @Icon("edit", 16)
                Edit Ticket
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="notice notice-success alert alert-dismissible fade show" role="alert">
            @Icon("check", 20)
            <div class="notice-body">@successMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="notice notice-error alert alert-dismissible fade show" role="alert">
            @Icon("alert", 20)
            <div class="notice-body">@errorMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Status lifecycle -->
    <div class="stepper" aria-label="Ticket lifecycle">
        @for (var step = 1; step <= 6; step++)
        {
            var stepClass = step < Model.Status ? "done" : step == Model.Status ? "current" : "";

            <div class="step @stepClass">
                <div class="step-dot">
                    @if (step < Model.Status)
                    {
                        @Icon("check", 14)
                    }
                    else
                    {
                        @step
                    }
                </div>
                <div class="step-label">@GetStatusLabel(step)</div>
            </div>
        }
    </div>

    <div class="td-grid">

        <!-- ========== Main column ========== -->
        <div class="td-col">

            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon">@Icon("ticket")</span>
                    <h2>Ticket Information</h2>
                </div>

                <h3 class="ticket-title">@Model.Title</h3>

                <div class="field">
                    <span class="field-label">Description</span>
                    <div class="description-box">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</div>
                </div>
            </section>

            <!-- Comments -->
            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon sky">@Icon("chat")</span>
                    <h2>Comments</h2>
                    <span class="count-chip">@Model.Comments.Count</span>
                </div>

                <form asp-action="AddComment"
                      asp-controller="Tickets"
                      method="post"
                      class="comment-form">

                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="field">
                        <label for="content" class="field-label">Add a comment</label>
                        <textarea id="content"
                                  name="content"
                                  rows="4"
                                  maxlength="2000"
                                  placeholder="Write your comment..."
                                  required></textarea>
                    </div>

                    <div class="comment-form-footer">
                        <label class="internal-option">
                            <input type="checkbox" name="isInternal" value="true" />
                            @Icon("lock", 14)
                            Internal comment
                        </label>

                        <button type="submit" class="btn-gradient">
                            @Icon("send", 16)
                            Add Comment
                        </button>
                    </div>
                </form>

                <div class="comments-list">
                    @if (Model.Comments.Count > 0)
                    {
                        foreach (var comment in Model.Comments.OrderByDescending(x => x.CreatedAt))
                        {
                            <article class="comment-item @(comment.IsInternal ? "internal" : "")">
                                <div class="comment-meta">
                                    <span>@comment.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy, HH:mm", inv)</span>

                                    @if (comment.IsInternal)
                                    {
                                        <span class="internal-badge">
                                            @Icon("lock", 11)
                                            Internal
                                        </span>
                                    }
                                </div>

                                <p class="comment-content">@comment.Content</p>
                            </article>
                        }
                    }
                    else
                    {
                        <p class="empty-section">No comments yet.</p>
                    }
                </div>
            </section>

            <!-- Activity history -->
            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon violet">@Icon("activity")</span>
                    <h2>Activity History</h2>
                    <span class="count-chip">@Model.Histories.Count</span>
                </div>

                @if (Model.Histories.Count > 0)
                {
                    <div class="history-list">
                        @foreach (var history in Model.Histories.OrderByDescending(x => x.CreatedAt))
                        {
                            <article class="history-item">
                                <div class="history-marker"></div>

                                <div class="history-content">
                                    <div class="history-meta">
                                        <strong>@history.Action</strong>
                                        <span>@history.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy, HH:mm", inv)</span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(history.ChangedBy))
                                    {
                                        <p class="history-actor">By @history.ChangedBy</p>
                                    }

                                    @if (history.OldValue is not null || history.NewValue is not null)
                                    {
                                        <div class="history-change">
                                            @if (history.OldValue is not null)
                                            {
                                                <span class="change-chip old">@history.OldValue</span>
                                            }

                                            @if (history.OldValue is not null && history.NewValue is not null)
                                            {
                                                <span class="change-arrow">@Icon("arrow", 14)</span>
                                            }

                                            @if (history.NewValue is not null)
                                            {
                                                <span class="change-chip new">@history.NewValue</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p class="empty-section">No activity history available.</p>
                }
            </section>

        </div>

        <!-- ========== Sidebar ========== -->
        <aside class="td-col">

            @if (allowedNextStatuses.Length > 0)
            {
                <section class="td-card">
                    <div class="card-head">
                        <span class="card-icon green">@Icon("refresh")</span>
                        <h2>Update Status</h2>
                    </div>

                    <form asp-action="ChangeStatus"
                          asp-controller="Tickets"
                          method="post"
                          class="status-form">

                        <input type="hidden" name="id" value="@Model.Id" />

                        <select name="status" class="form-select" aria-label="New status" required>
                            @foreach (var nextStatus in allowedNextStatuses)
                            {
                                <option value="@nextStatus">@GetStatusLabel(nextStatus)</option>
                            }
                        </select>

                        <button type="submit" class="btn-gradient">
                            @Icon("check", 16)
                            Update Status
                        </button>
                    </form>
                </section>
            }

            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon amber">@Icon("folder")</span>
                    <h2>Classification</h2>
                </div>

                <div class="field">
                    <span class="field-label">Category</span>
                    <p class="field-value">@Model.CategoryName</p>
                </div>

                <div class="field">
                    <span class="field-label">Department</span>
                    <p class="field-value">@Model.DepartmentName</p>
                </div>
            </section>

            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon sky">@Icon("users")</span>
                    <h2>People</h2>
                </div>

                <div class="field">
                    <span class="field-label">Requester ID</span>
                    <p class="field-value mono">@Model.RequesterId</p>
                </div>

                <div class="field">
                    <span class="field-label">Assignee ID</span>

                    @if (Model.AssigneeId is null)
                    {
                        <span class="pill pill-muted">Unassigned</span>
                    }
                    else
                    {
                        <p class="field-value mono">@Model.AssigneeId</p>
                    }
                </div>
            </section>

            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon violet">@Icon("clock")</span>
                    <h2>Timeline</h2>
                </div>

                <div class="field">
                    <span class="field-label">Created At</span>
                    <p class="field-value">@FormatDate(Model.CreatedAt)</p>
                </div>

                <div class="field">
                    <span class="field-label">Last Updated</span>
                    <p class="field-value">@FormatDate(Model.UpdatedAt)</p>
                </div>
            </section>

            <section class="td-card">
                <div class="card-head">
                    <span class="card-icon green">@Icon("shield")</span>
                    <h2>SLA Information</h2>
                </div>

                @if (Model.Sla is not null)
                {
                    <div class="sla-policy">
                        <span>SLA Policy</span>
                        <strong>@Model.Sla.SlaPolicyName</strong>
                    </div>

                    <div class="sla-item">
                        <span class="field-label">Response Deadline</span>
                        <p class="field-value">@FormatDate(Model.Sla.ResponseDeadline)</p>
                        <span class="sla-result @(Model.Sla.ResponseBreached ? "sla-breached" : "sla-normal")">
                            @(Model.Sla.ResponseBreached ? "Breached" : "Not breached")
                        </span>
                    </div>

                    <div class="sla-item">
                        <span class="field-label">Resolution Deadline</span>
                        <p class="field-value">@FormatDate(Model.Sla.ResolutionDeadline)</p>
                        <span class="sla-result @(Model.Sla.ResolutionBreached ? "sla-breached" : "sla-normal")">
                            @(Model.Sla.ResolutionBreached ? "Breached" : "Not breached")
                        </span>
                    </div>

                    <div class="sla-item">
                        <span class="field-label">First Response At</span>
                        <p class="field-value">@FormatDate(Model.Sla.FirstResponseAt)</p>
                    </div>

                    <div class="sla-item">
                        <span class="field-label">Resolved At</span>
                        <p class="field-value">@FormatDate(Model.Sla.ResolvedAt)</p>
                    </div>
                }
                else
                {
                    <p class="empty-section">No SLA information available for this ticket.</p>
                }
            </section>

        </aside>

    </div>
</div>