@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    bool IsActive(string controllerName) =>
        string.Equals(controller, controllerName, StringComparison.OrdinalIgnoreCase);

    string NavClass(bool active) => active ? "nav-link active" : "nav-link";

    var isSignedIn = !string.IsNullOrWhiteSpace(Context.Session.GetString("AccessToken"));
    var userEmail = Context.Session.GetString("Email") ?? string.Empty;
    var userRoles = (Context.Session.GetString("Roles") ?? string.Empty).Replace(",", " / ");
    var userInitial = string.IsNullOrWhiteSpace(userEmail) ? "U" : userEmail.Trim().Substring(0, 1).ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="en">
<head class="app-header">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Helpdesk</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ITHelpdeshMangament.styles.css" asp-append-version="true" />

    <style>
        html {
            position: relative;
            min-height: 100%;
        }

        body {
            margin: 0;
            margin-bottom: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
            color: #111827;
            background: #f6f7fb;
        }

        /* ---------- Navbar ---------- */
        .app-navbar {
            position: sticky;
            top: 0;
            z-index: 1030;
            padding: 10px 0;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #eef0f4;
        }

        .app-navbar .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            font-size: 1.1rem;
            font-weight: 700;
            color: #111827;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            color: #fff;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            box-shadow: 0 8px 16px -8px rgba(79, 70, 229, 0.7);
        }

        .app-navbar .navbar-nav {
            gap: 4px;
        }

        .app-navbar .nav-link {
            padding: 8px 14px;
            border-radius: 10px;
            font-size: 0.9rem;
            font-weight: 500;
            color: #4b5563;
            transition: background 0.15s, color 0.15s;
        }

            .app-navbar .nav-link:hover {
                color: #4f46e5;
                background: #f3f4f6;
            }

            .app-navbar .nav-link.active {
                color: #4f46e5;
                font-weight: 600;
                background: #eef2ff;
            }

        .app-navbar .navbar-toggler {
            border: 1.5px solid #e5e7eb;
            border-radius: 10px;
            padding: 6px 10px;
        }

            .app-navbar .navbar-toggler:focus {
                box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.15);
            }

        /* ---------- User menu ---------- */
        .user-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 4px 12px 4px 4px;
            border: 1.5px solid #e5e7eb;
            border-radius: 999px;
            background: #fff;
            color: #111827;
            font-size: 0.85rem;
            font-weight: 600;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

            .user-btn:hover,
            .user-btn:focus,
            .user-btn.show {
                border-color: #c7d2fe;
                box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
                color: #111827;
            }

            .user-btn::after {
                display: none;
            }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 0.85rem;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
        }

        .user-email {
            max-width: 180px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .user-menu {
            min-width: 240px;
            padding: 8px;
            border: 1px solid #eef0f4;
            border-radius: 14px;
            box-shadow: 0 20px 40px -16px rgba(17, 24, 39, 0.25);
        }

        .user-menu .user-meta {
            padding: 10px 12px 12px;
            border-bottom: 1px solid #eef0f4;
            margin-bottom: 6px;
        }

        .user-menu .user-meta .name {
            font-weight: 600;
            font-size: 0.88rem;
            word-break: break-all;
        }

        .user-menu .user-meta .role {
            font-size: 0.76rem;
            color: #9ca3af;
        }

        .user-menu .dropdown-item,
        .user-menu .signout-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            padding: 9px 12px;
            border: 0;
            border-radius: 10px;
            background: transparent;
            font-size: 0.86rem;
            font-weight: 500;
            color: #374151;
            text-align: left;
        }

            .user-menu .dropdown-item:hover,
            .user-menu .signout-btn:hover {
                background: #f3f4f6;
            }

        .user-menu .signout-btn {
            color: #dc2626;
        }

            .user-menu .signout-btn:hover {
                background: #fef2f2;
            }

        .btn-signin {
            display: inline-flex;
            align-items: center;
            height: 40px;
            padding: 0 20px;
            border: 0;
            border-radius: 10px;
            font-size: 0.88rem;
            font-weight: 600;
            color: #fff;
            text-decoration: none;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            box-shadow: 0 10px 20px -10px rgba(79, 70, 229, 0.7);
            transition: transform 0.15s, box-shadow 0.15s;
        }

            .btn-signin:hover {
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 14px 24px -10px rgba(79, 70, 229, 0.8);
            }

        /* ---------- Main + footer ---------- */
        .app-main {
            flex: 1 0 auto;
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
            padding: 8px 16px 24px;
        }

        .app-footer {
            flex-shrink: 0;
            padding: 18px 0;
            border-top: 1px solid #eef0f4;
            background: #fff;
            font-size: 0.82rem;
            color: #9ca3af;
        }

            .app-footer a {
                color: #6b7280;
                text-decoration: none;
            }

                .app-footer a:hover {
                    color: #4f46e5;
                }

        @@media (max-width: 575.98px) {
            .app-main {
                padding: 4px 8px 16px;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md app-navbar">
            <div class="container-fluid px-3 px-lg-4">

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 18v-6a9 9 0 0 1 18 0v6" />
                            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" />
                        </svg>
                    </span>
                    IT Helpdesk
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse justify-content-between" id="mainNav">

                    <ul class="navbar-nav ms-md-4 mt-3 mt-md-0">
                        <li class="nav-item">
                            <a class="@NavClass(IsActive("Home") && !string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Privacy", StringComparison.OrdinalIgnoreCase))"
                               asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (isSignedIn)
                        {
                            <li class="nav-item">
                                <a class="@NavClass(IsActive("Dashboard"))"
                                   asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>

                            <li class="nav-item">
                                <a class="@NavClass(IsActive("Tickets"))"
                                   asp-controller="Tickets" asp-action="Index">Ticket Management</a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="@NavClass(IsActive("Home") && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Privacy", StringComparison.OrdinalIgnoreCase))"
                               asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    <div class="mt-3 mt-md-0">
                        @if (isSignedIn)
                        {
                            <div class="dropdown">
                                <button class="user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-avatar">@userInitial</span>
                                    <span class="user-email">@(string.IsNullOrWhiteSpace(userEmail) ? "Account" : userEmail)</span>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                                </button>

                                <div class="dropdown-menu dropdown-menu-end user-menu">
                                    <div class="user-meta">
                                        <div class="name">@userEmail</div>
                                        @if (!string.IsNullOrWhiteSpace(userRoles))
                                        {
                                            <div class="role">@userRoles</div>
                                        }
                                    </div>

                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="signout-btn">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                                <polyline points="16 17 21 12 16 7" />
                                                <line x1="21" y1="12" x2="9" y2="12" />
                                            </svg>
                                            Sign out
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a class="btn-signin" asp-controller="Account" asp-action="Login">Sign in</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="app-main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container-fluid px-3 px-lg-4 d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year IT Helpdesk Management System</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <button type="button"
            id="backToTop"
            class="back-to-top"
            aria-label="Back to top"
            title="Back to top"
            hidden>
        <svg width="22" height="22" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 19V5" />
            <path d="m5 12 7-7 7 7" />
        </svg>
    </button>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
